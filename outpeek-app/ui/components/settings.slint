// Settings view. Same sheet as the tracker: hairlines and bands, no stack of
// rounded cards. Every row is a fact resolved on this machine or an honest
// "not available"; there is no decorative control and no disabled fake.
//
// Left column: the controls and paths that exist today.
// Right column: build facts, the MCP port, and the list of what is absent.

import { Theme, TypeScale, Space } from "tokens.slint";
import { Tracker, Settings } from "../state.slint";
import { Band, Caption, HudToggle, PanelTitle, StateDot } from "widgets.slint";

/// A path row. The path is selectable text (TextInput read-only), so Ctrl+C
/// copies it without adding a clipboard dependency or a fake "copy" claim.
/// Two lines, word-wrapped: a %LOCALAPPDATA% path is longer than any sane
/// column width, and clipping it mid-segment reads as a bug, not as a cap.
component PathRow inherits VerticalLayout {
    in property <string> label: "";
    in property <string> value: "";
    in property <bool> resolved: true;

    spacing: 4px;

    PanelTitle { text: root.label; }

    Rectangle {
        height: 34px;
        min-width: 0;
        clip: true;
        background: transparent;

        TextInput {
            x: 0;
            y: 0;
            min-width: 0;
            width: parent.width;
            height: parent.height;
            text: root.value;
            read-only: true;
            single-line: false;
            wrap: word-wrap;
            font-family: Theme.font-mono;
            font-size: TypeScale.micro;
            color: root.resolved ? Theme.ink : Theme.amber;
            vertical-alignment: top;
        }
    }
}

/// Small square bullet for the not-ported list.
component Bullet inherits Rectangle {
    width: 4px;
    height: 4px;
    border-radius: 1px;
    background: Theme.primary;
    opacity: 0.7;
}

export component SettingsPage inherits VerticalLayout {
    callback toggle-hud();

    padding-left: Space.xl;
    padding-right: Space.xl;
    padding-top: 20px;
    padding-bottom: 20px;
    spacing: 0;

    HorizontalLayout {
        spacing: Space.xl;

        // ---- Left: controls and paths -------------------------------------
        VerticalLayout {
            horizontal-stretch: 3;
            spacing: 0;

            Band {
                label: "HUD OVERLAY";
                note: "CANONICAL";
                rule: false;

                HorizontalLayout {
                    height: 26px;
                    spacing: Space.md;

                    Text {
                        text: "Overlay shown in game";
                        font-family: Theme.font-display;
                        font-size: TypeScale.title;
                        font-weight: 700;
                        color: Theme.ink;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    HudToggle {
                        checked: Tracker.hud-enabled;
                        toggled => { root.toggle-hud(); }
                    }
                }

                HorizontalLayout {
                    spacing: Space.sm;
                    alignment: start;

                    StateDot {
                        tone: Tracker.hud-tone;
                        y: 4px;
                    }
                    Text {
                        text: Tracker.hud-status;
                        font-family: Theme.font-body;
                        font-size: TypeScale.caption;
                        color: Tracker.hud-tone == "live" ? Theme.mint : Theme.ink-faint;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }

                Caption { text: Settings.hud-rule; }

                PathRow {
                    label: "PERSISTED TO";
                    value: Settings.hud-file;
                    resolved: Settings.data-resolved;
                }
            }

            Band {
                label: "APPEARANCE";

                Text {
                    text: "Dark only";
                    font-family: Theme.font-display;
                    font-size: TypeScale.title;
                    font-weight: 700;
                    color: Theme.ink-dim;
                }

                Caption { text: Settings.theme-line; }
            }

            Band {
                label: "DATA & LOGS";

                PathRow {
                    label: "APP DATA";
                    value: Settings.data-path;
                    resolved: Settings.data-resolved;
                }

                PathRow {
                    label: "LOG DIRECTORY";
                    value: Settings.log-path;
                    resolved: Settings.log-resolved;
                }

                Caption {
                    text: "Both paths are selectable — click and Ctrl+C. This shell reads them; it does not write log files yet.";
                }
            }

            Rectangle { vertical-stretch: 1; }
        }

        // Column rule: the same hairline the bands use, turned vertical.
        Rectangle {
            width: 1px;
            background: Theme.line-soft;
        }

        // ---- Right: build facts and the honest list ------------------------
        VerticalLayout {
            max-width: 480px;
            horizontal-stretch: 2;
            spacing: 0;

            Band {
                label: "SLINT MCP";
                note: Settings.mcp-tone == "ok" ? "ON" : (Settings.mcp-tone == "warn" ? "INVALID" : "OFF");
                note-tone: Settings.mcp-tone == "ok" ? "live" : (Settings.mcp-tone == "warn" ? "armed" : "off");
                rule: false;

                Caption { text: Settings.mcp-line; }
            }

            Band {
                label: "BUILD";

                Text {
                    text: Settings.version-line;
                    font-family: Theme.font-display;
                    font-size: TypeScale.big;
                    font-weight: 800;
                    color: Theme.primary;
                }

                Text {
                    text: Settings.build-line;
                    font-family: Theme.font-mono;
                    font-size: TypeScale.micro;
                    color: Theme.ink-dim;
                    wrap: word-wrap;
                }

                Caption {
                    text: "Read-only build: loopback reads only, no memory access, no Riot writes.";
                }
            }

            Band {
                label: "NOT PORTED YET";
                note: "HONEST LIST";

                for item in Settings.not-ported: HorizontalLayout {
                    spacing: Space.sm;
                    alignment: start;

                    Bullet {
                        y: 6px;
                    }

                    VerticalLayout {
                        spacing: 1px;
                        horizontal-stretch: 1;

                        Text {
                            text: item.title;
                            font-family: Theme.font-body;
                            font-size: TypeScale.caption;
                            font-weight: 700;
                            color: Theme.ink-dim;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: item.detail;
                            font-family: Theme.font-body;
                            font-size: TypeScale.micro;
                            color: Theme.ink-faint;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }
    }
}
