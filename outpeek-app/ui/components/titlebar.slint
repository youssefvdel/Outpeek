// Window chrome. The shell is frameless (`no-frame: true` in app.slint), so
// this 38px row is the title bar: a drag surface on the left, then the client
// state, the two real actions, and the three window controls flush right.
//
// Geometry contract: the drag surface is everything left of the controls and
// `app_window::titlebar_layout` carries the same numbers (tested). Slint's
// `resize-border-width` band sits above this row at the edges, so a press
// within 6px of an edge resizes instead of dragging — same as Windows.
//
// The page title is NOT here: it sits in the header band below, which keeps
// this row to window facts only and avoids two competing headings.

import { Theme, TypeScale, Space, Shape, Motion } from "tokens.slint";
import { Tracker } from "../state.slint";
import { Glyph, IconButton, StateDot, VCenter } from "widgets.slint";

/// One window button. Glyphs come from the generated Lucide set (`icons.slint`)
/// through `Glyph`: no icon font, no image, no new hex.
component WindowButton inherits Rectangle {
    in property <length> button-width: 46px;
    in property <string> glyph: "minimize"; // minimize | maximize | restore | close
    in property <string> label: "Minimize";
    callback clicked();

    width: root.button-width;
    // Close is the one destructive control: it gets the coral fill on hover so
    // it reads as a warning, every other button lifts one container step.
    background: root.glyph == "close"
        ? touch.has-hover ? Theme.coral : transparent
        : touch.pressed
            ? Theme.container-highest
            : touch.has-hover
                ? Theme.container-high
                : transparent;
    animate background { duration: Motion.fast; easing: ease-out; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { touch.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    out property <bool> has-focus: scope.has-focus;

    scope := FocusScope {
        x: 0;
        width: 0; // Tab-focusable, but clicks must land on the button.

        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }

    if root.has-focus: Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        border-radius: Shape.sm;
        border-width: 2px;
        border-color: Theme.primary;
        background: transparent;
    }

    // Lucide glyphs, the same three the shipping titlebar uses: Minus,
    // Square/Copy (maximize/restore) and X.
    Glyph {
        kind: root.glyph == "minimize" ? "minus"
            : root.glyph == "maximize" ? "square"
                : root.glyph == "restore" ? "copy"
                    : "x";
        size: 13px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        stroke: root.glyph == "close"
            ? touch.has-hover ? Theme.surface-dim : Theme.ink-dim
            : touch.has-hover ? Theme.ink : Theme.ink-dim;
    }
}

export component TitleBar inherits Rectangle {
    in property <length> bar-height: 38px;
    in property <length> control-width: 46px;
    // Rust owns the maximised fact, so the glyph is a binding, not a guess.
    in property <string> max-glyph: "maximize";
    in property <string> max-label: "Maximize";
    callback minimize-window();
    callback toggle-maximize();
    callback close-window();
    callback refresh-rank();
    callback toggle-hud();

    height: root.bar-height;
    background: Theme.surface;

    // Declared first so it sits under the status text (no input) and under the
    // buttons — which are declared after it, so a press on a button is a press
    // on the button, never a drag.
    WindowMoveArea {
        x: 0;
        y: 0;
        width: parent.width - root.control-width * 3;
        height: parent.height;
    }

    // Bottom hairline, continuous with the header band's own rule.
    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.line-soft;
    }

    HorizontalLayout {
        padding-left: Space.lg;
        padding-right: 0;
        spacing: 4px;

        Rectangle { horizontal-stretch: 1; }

        // Client state. One dot, two words: the long client line lives in the
        // player card and the settings page, not in chrome.
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 6px;

            VCenter { StateDot { tone: Tracker.client-tone == "ok" ? "ok" : "warn"; } }
            Text {
                text: Tracker.client-tone == "ok" ? "Stats on" : "Offline";
                font-family: Theme.font-body;
                font-size: TypeScale.caption;
                font-weight: 500;
                color: Theme.ink-dim;
                vertical-alignment: center;
            }
        }

        Rectangle { width: Space.sm; }

        if Tracker.view == "tracker": VCenter {
            IconButton {
                glyph: "refresh";
                label: "Refresh rank";
                enabled: Tracker.rank-state != "loading" && Tracker.rank-state != "waiting";
                clicked => { root.refresh-rank(); }
            }
        }

        VCenter {
            IconButton {
                glyph: "shield";
                label: Tracker.hud-enabled ? "Hide HUD" : "Show HUD";
                tone: Tracker.hud-tone == "live" || Tracker.hud-tone == "armed" ? Theme.mint : Theme.ink-faint;
                clicked => { root.toggle-hud(); }
            }
        }

        Rectangle { width: 6px; }

        WindowButton {
            button-width: root.control-width;
            glyph: "minimize";
            label: "Minimize";
            clicked => { root.minimize-window(); }
        }
        WindowButton {
            button-width: root.control-width;
            glyph: root.max-glyph;
            label: root.max-label;
            clicked => { root.toggle-maximize(); }
        }
        WindowButton {
            button-width: root.control-width;
            glyph: "close";
            label: "Close";
            clicked => { root.close-window(); }
        }
    }
}
