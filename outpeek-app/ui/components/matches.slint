// Matches tab: the TRN-website history — a top-3 agent strip, a recent-form
// strip, then one group per day (header aggregates plus that day's rows).
// Every cell is pre-formatted by Rust (`MatchAgentUi` / `MatchFormUi` /
// `MatchDayUi` / `MatchRowUi`), so this view cannot round, re-derive or invent
// a value. TRS, clutch and placement chips render only what the payload
// reported; weapon stats have no source, so no panel shows them here either.
//
// A row click opens the scoreboard in place (`Tracker.select-match(id)`): the
// detail view replaces the table, Back clears the selection and the table
// returns — there is no separate tab. Loading reads "Reading match…", a fetch
// failure is an inline error card with a retry, never a blank view.

import { Theme, Space, Shape, TypeScale, Motion } from "tokens.slint";
import { Tracker, MatchRowUi, MatchPlayerUi, MatchRoundUi, MatchAgentUi, MatchFormUi, MatchDayUi } from "../state.slint";
import { Card, Cell, ColumnLabel, VCenter, Glyph } from "widgets.slint";

component StatChip inherits Rectangle {
    in property <string> text;
    in property <brush> chip-ink: Theme.ink;
    in property <length> chip-width: 76px;
    width: root.chip-width;
    height: 24px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.line-soft;
    Text {
        text: root.text;
        font-family: Theme.font-mono;
        font-size: TypeScale.micro;
        font-weight: 600;
        color: root.chip-ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

component MatchLine inherits Rectangle {
    in property <MatchRowUi> item;
    height: 48px;
    background: line-touch.has-hover ? Theme.container-low : transparent;
    animate background { duration: Motion.fast; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.item.age + " " + root.item.map + " " + root.item.score + " " + root.item.trs + " " + root.item.clutch;
    accessible-action-default => { line-touch.clicked(); }

    line-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Tracker.select-match(root.item.id); }
    }

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.sm;

        // Agent portrait: the row's own face, like the desktop client. The
        // tinted plate is the fallback floor when the catalogue missed.
        VCenter {
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: Theme.primary-deep;
                clip: true;

                if root.item.art.width > 0: Image {
                    source: root.item.art;
                    width: 32px;
                    height: 32px;
                    image-fit: contain;
                }
                if root.item.art.width == 0: Glyph {
                    kind: "user";
                    size: 15px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    stroke: Theme.primary;
                    opacity: 0.7;
                }
            }
        }

        // Age + mode over map: one moment, two lines, the website's own
        // stacking. Wide enough that "2d ago // Competitive" never elides.
        VerticalLayout {
            width: 150px;
            spacing: 1px;

            Text {
                text: root.item.age == "" ? "—" : root.item.age;
                font-family: Theme.font-body;
                font-size: TypeScale.caption;
                color: Theme.ink-faint;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.item.map == "" ? "—" : root.item.map;
                font-family: Theme.font-body;
                font-size: TypeScale.caption;
                font-weight: 600;
                color: Theme.ink;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // The rounds score in the result colour ("14 : 16"): the row's verdict
        // at a glance, no chip needed.
        VCenter {
            Text {
                width: 64px;
                text: root.item.score == "" ? "—" : root.item.score;
                font-family: Theme.font-mono;
                font-size: TypeScale.caption;
                font-weight: 700;
                color: root.item.score == ""
                    ? Theme.ink-faint
                    : root.item.won ? Theme.mint : Theme.coral;
                vertical-alignment: center;
            }
        }

        Cell { col-width: 76px; value: root.item.agent; }
        if root.item.trs != "": VCenter {
            StatChip {
                text: root.item.trs;
                chip-width: 76px;
                chip-ink: Theme.ink;
            }
        }
        if root.item.clutch != "": VCenter {
            StatChip {
                text: root.item.clutch;
                chip-width: 96px;
                // Signed by the tone itself: a lost clutch is the bad case.
                chip-ink: root.item.clutch-bad ? Theme.coral : Theme.mint;
            }
        }
        Cell { col-width: 92px; value: root.item.kda; mono: true; align-right: true; }
        Cell { col-width: 52px; value: root.item.kd; mono: true; align-right: true; }
        Cell { col-width: 52px; value: root.item.hs; mono: true; align-right: true; }
        Cell {
            col-width: 64px;
            value: root.item.dd;
            mono: true;
            align-right: true;
            // Signed by the number itself: a delta over zero is the good case.
            ink: root.item.dd == ""
                ? Theme.ink-dim
                : root.item.dd.starts-with("-") ? Theme.coral : Theme.mint;
        }
        Cell { col-width: 52px; value: root.item.acs; mono: true; align-right: true; }
        Rectangle { horizontal-stretch: 1; }
    }

    Rectangle {
        x: Space.md;
        y: parent.height - 1px;
        width: parent.width - Space.md * 2;
        height: 1px;
        background: Theme.line-soft;
    }
}

component AgentCard inherits Rectangle {
    in property <MatchAgentUi> item;
    horizontal-stretch: 1;
    HorizontalLayout {
        spacing: Space.sm;

        // Portrait: the agent's own face, like the Agents tab. The tinted
        // plate is the fallback floor when the catalogue missed.
        VCenter {
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                background: Theme.primary-deep;
                clip: true;

                if root.item.art.width > 0: Image {
                    source: root.item.art;
                    width: 40px;
                    height: 40px;
                    image-fit: contain;
                }
                if root.item.art.width == 0: Glyph {
                    kind: "user";
                    size: 18px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    stroke: Theme.primary;
                    opacity: 0.7;
                }
            }
        }

        // Name over record over K/D.
        VCenter {
            VerticalLayout {
                spacing: 1px;

                Text {
                    text: root.item.name == "" ? "—" : root.item.name;
                    font-family: Theme.font-body;
                    font-size: TypeScale.caption;
                    font-weight: 600;
                    color: Theme.ink;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: root.item.record == "" ? "—" : root.item.record;
                    font-family: Theme.font-body;
                    font-size: TypeScale.micro;
                    color: Theme.ink-faint;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: root.item.kd == "" ? "—" : root.item.kd;
                    font-family: Theme.font-mono;
                    font-size: TypeScale.micro;
                    color: Theme.ink-dim;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

component FormCell inherits Rectangle {
    in property <MatchFormUi> item;
    horizontal-stretch: 1;
    VerticalLayout {
        spacing: 1px;

        Text {
            text: root.item.age == "" ? "—" : root.item.age;
            font-family: Theme.font-body;
            font-size: TypeScale.micro;
            color: Theme.ink-faint;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.item.score == "" ? "—" : root.item.score;
            font-family: Theme.font-mono;
            font-size: TypeScale.caption;
            font-weight: 700;
            color: root.item.score == ""
                ? Theme.ink-faint
                : root.item.won ? Theme.mint : Theme.coral;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.item.kd == "" ? "—" : root.item.kd;
            font-family: Theme.font-mono;
            font-size: TypeScale.micro;
            color: Theme.ink-dim;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component DayHeader inherits Rectangle {
    in property <MatchDayUi> item;
    height: 34px;
    background: Theme.container-low;
    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.sm;

        VCenter {
            Text {
                text: root.item.title == "" ? "—" : root.item.title;
                font-family: Theme.font-body;
                font-size: TypeScale.caption;
                font-weight: 700;
                color: Theme.ink;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        VCenter {
            Text {
                text: root.item.wl == "" ? "—" : root.item.wl;
                font-family: Theme.font-body;
                font-size: TypeScale.micro;
                color: Theme.ink-faint;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        // Tail order and widths mirror the table below (K/D/A, K/D, HS %,
        // DDΔ, ACS) so the day sums sit over the columns they total. The K/D/A
        // triple needs its own width — it never fits the table's 92 px. The
        // chip-width spacers stand in for the rows' TRS/CLUTCH chips.
        Rectangle { width: 76px; }
        Rectangle { width: 96px; }
        Cell { col-width: 150px; value: root.item.kda; mono: true; align-right: true; }
        Cell { col-width: 52px; value: root.item.kd; mono: true; align-right: true; }
        Cell { col-width: 52px; value: root.item.hs; mono: true; align-right: true; }
        Cell {
            col-width: 64px;
            value: root.item.dda;
            mono: true;
            align-right: true;
            // Signed by the number itself, like the rows below.
            ink: root.item.dda == ""
                ? Theme.ink-dim
                : root.item.dda.starts-with("-") ? Theme.coral : Theme.mint;
        }
        Cell { col-width: 52px; value: root.item.acs; mono: true; align-right: true; }
    }

    Rectangle {
        x: Space.md;
        y: parent.height - 1px;
        width: parent.width - Space.md * 2;
        height: 1px;
        background: Theme.line-soft;
    }
}

component DetailPlayerLine inherits Rectangle {
    in property <MatchPlayerUi> item;
    height: 44px;
    background: transparent;

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.sm;

        VCenter {
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 7px;
                background: Theme.primary-deep;
                clip: true;

                if root.item.art.width > 0: Image {
                    source: root.item.art;
                    width: 28px;
                    height: 28px;
                    image-fit: contain;
                }
                if root.item.art.width == 0: Glyph {
                    kind: "user";
                    size: 13px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    stroke: Theme.primary;
                    opacity: 0.7;
                }
            }
        }

        // Name over rank: one player, two lines.
        VerticalLayout {
            width: 150px;
            spacing: 1px;

            Text {
                text: root.item.name == "" ? "—" : root.item.name;
                font-family: Theme.font-body;
                font-size: TypeScale.caption;
                font-weight: 600;
                color: Theme.ink;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.item.rank == "" ? "—" : root.item.rank;
                font-family: Theme.font-body;
                font-size: TypeScale.micro;
                color: Theme.ink-faint;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Cell { col-width: 72px; value: root.item.agent; }
        Cell { col-width: 48px; value: root.item.acs; mono: true; align-right: true; }
        Cell { col-width: 92px; value: root.item.kda; mono: true; align-right: true; }
        Cell { col-width: 48px; value: root.item.kd; mono: true; align-right: true; }
        Cell { col-width: 56px; value: root.item.hs; mono: true; align-right: true; }
        Cell { col-width: 56px; value: root.item.kast; mono: true; align-right: true; }
        Cell {
            col-width: 64px;
            value: root.item.dd;
            mono: true;
            align-right: true;
            ink: root.item.dd == ""
                ? Theme.ink-dim
                : root.item.dd.starts-with("-") ? Theme.coral : Theme.mint;
        }
        Rectangle { horizontal-stretch: 1; }
    }

    Rectangle {
        x: Space.md;
        y: parent.height - 1px;
        width: parent.width - Space.md * 2;
        height: 1px;
        background: Theme.line-soft;
    }
}

component TeamCard inherits VerticalLayout {
    in property <string> title: "";
    in property <bool> won: false;
    in property <[MatchPlayerUi]> rows: [];

    Card {
        pad: 0px;
        gap: 0px;

        Rectangle {
            height: 34px;
            background: transparent;

            HorizontalLayout {
                padding-left: Space.md;
                padding-right: Space.md;
                spacing: Space.sm;

                ColumnLabel { col-width: 28px; text: ""; }
                ColumnLabel { col-width: 150px; text: root.title; }
                ColumnLabel { col-width: 72px; text: "AGENT"; }
                ColumnLabel { col-width: 48px; text: "ACS"; align-right: true; }
                ColumnLabel { col-width: 92px; text: "K / D / A"; align-right: true; }
                ColumnLabel { col-width: 48px; text: "K/D"; align-right: true; }
                ColumnLabel { col-width: 56px; text: "HS %"; align-right: true; }
                ColumnLabel { col-width: 56px; text: "KAST"; align-right: true; }
                ColumnLabel { col-width: 64px; text: "DDΔ"; align-right: true; }
            }
        }

        for player in root.rows: DetailPlayerLine { item: player; }
    }
}

component RoundCell inherits Rectangle {
    in property <MatchRoundUi> item;
    callback tapped(string);
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: root.item.blue ? Theme.mint : Theme.coral;
    accessible-role: button;
    accessible-label: root.item.tip;

    Text {
        text: root.item.label;
        font-family: Theme.font-mono;
        font-size: TypeScale.micro;
        font-weight: 700;
        color: Theme.surface-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.tapped(root.item.tip); }
        mouse-cursor: pointer;
    }
}

export component MatchesPage inherits VerticalLayout {
    // Same page box as Overview/Agents/Maps/Live.
    padding-left: Space.xl;
    padding-right: Space.xl;
    padding-top: 20px;
    padding-bottom: 20px;
    spacing: Space.md;

    // The tapped round's result line: the colour is never the only signal.
    property <string> round-tip: "";

    if Tracker.match-id == "": VerticalLayout {
        spacing: Space.md;

        // Top-3 agents this season: portrait, name, W-L record, K/D.
        if Tracker.match-agents.length > 0: Card {
            VerticalLayout {
                padding-left: Space.md;
                padding-right: Space.md;
                padding-top: Space.sm;
                padding-bottom: Space.sm;
                spacing: Space.sm;
                ColumnLabel { text: "TOP AGENTS"; }
                HorizontalLayout {
                    spacing: Space.md;
                    for agent in Tracker.match-agents: AgentCard { item: agent; }
                }
            }
        }

        // Recent form: the last 8 matches, newest first.
        if Tracker.match-form.length > 0: Card {
            VerticalLayout {
                padding-left: Space.md;
                padding-right: Space.md;
                padding-top: Space.sm;
                padding-bottom: Space.sm;
                spacing: Space.sm;
                ColumnLabel { text: "RECENT FORM"; }
                HorizontalLayout {
                    spacing: Space.md;
                    for cell in Tracker.match-form: FormCell { item: cell; }
                }
            }
        }

        Card {
            pad: 0px;
            gap: 0px;

            // Header row. Column widths are the row's identical numbers.
            Rectangle {
                height: 34px;
                background: transparent;

                HorizontalLayout {
                    padding-left: Space.md;
                    padding-right: Space.md;
                    spacing: Space.sm;

                    ColumnLabel { col-width: 32px; text: ""; }
                    ColumnLabel { col-width: 150px; text: "MATCH"; }
                    ColumnLabel { col-width: 64px; text: "SCORE"; }
                    ColumnLabel { col-width: 76px; text: "AGENT"; }
                    ColumnLabel { col-width: 76px; text: "TRS"; }
                    ColumnLabel { col-width: 96px; text: "CLUTCH"; }
                    ColumnLabel { col-width: 92px; text: "K / D / A"; align-right: true; }
                    ColumnLabel { col-width: 52px; text: "K/D"; align-right: true; }
                    ColumnLabel { col-width: 52px; text: "HS %"; align-right: true; }
                    ColumnLabel { col-width: 64px; text: "DDΔ"; align-right: true; }
                    ColumnLabel { col-width: 52px; text: "ACS"; align-right: true; }
                }
            }

            if Tracker.match-days.length == 0: Rectangle {
                height: 120px;
                background: transparent;

                // The band is gone by design: the reason lives here, in the empty
                // card, instead of a strip above the table.
                Text {
                    text: Tracker.matches-note == "" ? "No matches yet." : Tracker.matches-note;
                    font-family: Theme.font-body;
                    font-size: TypeScale.caption;
                    color: Theme.ink-faint;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            for day[i] in Tracker.match-days: VerticalLayout {
                DayHeader { item: day; }
                for entry in Tracker.match-day-rows[i]: MatchLine { item: entry; }
            }
        }
    }

    if Tracker.match-id != "": VerticalLayout {
        spacing: Space.md;

        // Header strip: Back, then map + mode + date + duration, then the
        // Blue X – Y Red score the rounds voted for.
        Card {
            HorizontalLayout {
                padding-left: Space.md;
                padding-right: Space.md;
                padding-top: Space.sm;
                padding-bottom: Space.sm;
                spacing: Space.md;

                back-touch := TouchArea {
                    clicked => { Tracker.close-match-detail(); }
                    mouse-cursor: pointer;
                }
                VCenter {
                    Text {
                        text: "‹ Back";
                        accessible-role: button;
                        accessible-label: "Back to matches";
                        accessible-action-default => { back-touch.clicked(); };
                        font-family: Theme.font-body;
                        font-size: TypeScale.caption;
                        font-weight: 600;
                        color: back-touch.has-hover ? Theme.ink : Theme.primary;
                    }
                }
                VCenter {
                    VerticalLayout {
                        spacing: 1px;
                        Text {
                            text: Tracker.match-title == "" ? "—" : Tracker.match-title;
                            font-family: Theme.font-body;
                            font-size: TypeScale.caption;
                            font-weight: 700;
                            color: Theme.ink;
                            overflow: elide;
                        }
                        if root.round-tip != "": Text {
                            text: root.round-tip;
                            font-family: Theme.font-body;
                            font-size: TypeScale.micro;
                            color: Theme.ink-faint;
                            overflow: elide;
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                VCenter {
                    Text {
                        text: Tracker.match-score == "" ? "—" : Tracker.match-score;
                        font-family: Theme.font-mono;
                        font-size: TypeScale.body;
                        font-weight: 700;
                        color: Theme.ink;
                    }
                }
            }
        }

        if Tracker.match-state == "loading": Card {
            Rectangle {
                height: 120px;
                background: transparent;
                Text {
                    text: "Reading match…";
                    font-family: Theme.font-body;
                    font-size: TypeScale.caption;
                    color: Theme.ink-faint;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if Tracker.match-state == "error": Card {
            VerticalLayout {
                padding-left: Space.md;
                padding-right: Space.md;
                padding-top: Space.md;
                padding-bottom: Space.md;
                spacing: Space.sm;
                Text {
                    text: Tracker.match-note == "" ? "The scoreboard did not load." : Tracker.match-note;
                    font-family: Theme.font-body;
                    font-size: TypeScale.caption;
                    color: Theme.coral;
                    wrap: word-wrap;
                }
                retry-touch := TouchArea {
                    clicked => { Tracker.select-match(Tracker.match-id); }
                    mouse-cursor: pointer;
                }
                Text {
                    text: "Retry";
                    accessible-role: button;
                    accessible-label: "Retry loading match";
                    accessible-action-default => { retry-touch.clicked(); };
                    font-family: Theme.font-body;
                    font-size: TypeScale.caption;
                    font-weight: 600;
                    color: retry-touch.has-hover ? Theme.ink : Theme.primary;
                }
            }
        }

        if Tracker.match-state == "ready": VerticalLayout {
            spacing: Space.md;

            TeamCard {
                title: Tracker.match-blue-won ? "Blue — Victory" : "Blue";
                won: Tracker.match-blue-won;
                rows: Tracker.match-blue;
            }
            TeamCard {
                title: Tracker.match-red-won ? "Red — Victory" : "Red";
                won: Tracker.match-red-won;
                rows: Tracker.match-red;
            }

            // Rounds strip: one cell per round, coloured by the winner. The
            // result names each cell to screen readers (`accessible-label`)
            // and a tap lands it in the header line above.
            Card {
                VerticalLayout {
                    padding-left: Space.md;
                    padding-right: Space.md;
                    padding-top: Space.sm;
                    padding-bottom: Space.sm;
                    spacing: Space.sm;
                    HorizontalLayout {
                        spacing: 4px;
                        for r in Tracker.match-rounds: RoundCell {
                            item: r;
                            tapped(tip) => { root.round-tip = tip; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text {
                        text: "Each cell is one round — tap it for the result.";
                        font-family: Theme.font-body;
                        font-size: TypeScale.micro;
                        color: Theme.ink-faint;
                    }
                }
            }
        }
    }
}
