// Matches tab: the last 20 played games, straight from the same keyless
// Tracker Network read that fills the Overview. Every cell is pre-formatted by
// Rust (`MatchRowUi`), so this view cannot round, re-derive or invent a value.
//
// When there is nothing to show, the note says why: no account read yet, a
// network failure with the saved list's age, or a genuinely empty history are
// three different sentences on purpose.

import { Theme, Space, Shape, TypeScale, Motion } from "tokens.slint";
import { Tracker, MatchRowUi } from "../state.slint";
import { Card, Cell, Chip, ColumnLabel, VCenter, Glyph } from "widgets.slint";

component ResultChip inherits Rectangle {
    in property <string> label: "";
    in property <bool> won: false;
    width: 74px;
    height: 22px;
    border-radius: Shape.sm;
    background: root.won ? Theme.mint-wash : Theme.coral-wash;
    border-width: 1px;
    border-color: root.won ? Theme.mint-edge : Theme.coral-edge;

    Text {
        text: root.label;
        font-family: Theme.font-body;
        font-size: TypeScale.micro;
        font-weight: 700;
        color: root.won ? Theme.mint : Theme.coral;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component MatchLine inherits Rectangle {
    in property <MatchRowUi> item;
    height: 44px;
    background: line-touch.has-hover ? Theme.container-low : transparent;
    animate background { duration: Motion.fast; easing: ease-out; }

    line-touch := TouchArea {}

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;

        Cell { col-width: 66px; value: root.item.date; ink: Theme.ink-faint; mono: true; }
        Cell { col-width: 108px; value: root.item.mode; }
        Cell { col-width: 150px; value: root.item.map; ink: Theme.ink; weight: 600; }
        VCenter { ResultChip { label: root.item.result; won: root.item.won; } }
        Cell { col-width: 110px; value: root.item.agent; }
        Cell { col-width: 104px; value: root.item.kda; mono: true; }
        Cell {
            col-width: 72px;
            value: root.item.dd;
            mono: true;
            // Signed by the number itself: a delta over zero is the good case.
            ink: root.item.dd == ""
                ? Theme.ink-dim
                : root.item.dd.starts-with("-") ? Theme.coral : Theme.mint;
        }
        Cell { col-width: 76px; value: root.item.score; mono: true; }
        Cell { col-width: 62px; value: root.item.rounds; mono: true; ink: Theme.ink-faint; }
        Rectangle { horizontal-stretch: 1; }
    }

    Rectangle {
        x: Space.md;
        y: parent.height - 1px;
        width: parent.width - Space.md * 2;
        height: 1px;
        background: Theme.line-soft;
    }
}

export component MatchesPage inherits VerticalLayout {
    spacing: Space.md;

    // Note band: the only place the page explains itself.
    Rectangle {
        height: 34px;
        border-radius: Shape.sm;
        background: Theme.container-low;
        border-width: 1px;
        border-color: Theme.line-soft;

        HorizontalLayout {
            padding-left: Space.md;
            padding-right: Space.md;
            spacing: Space.sm;

            VCenter {
                Glyph {
                    kind: "tracker";
                    size: 14px;
                    stroke: Theme.ink-faint;
                }
            }
            Text {
                text: Tracker.matches-state == "ready"
                    ? "Last 20 matches · Tracker Network, read-only"
                    : Tracker.matches-note;
                font-family: Theme.font-body;
                font-size: TypeScale.micro;
                color: Theme.ink-dim;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            VCenter {
                Chip {
                    text: Tracker.matches-state == "ready"
                        ? "LIVE"
                        : Tracker.matches-state == "cached" ? "SAVED" : "NOT READ";
                    tone: Tracker.matches-state == "ready"
                        ? "mint"
                        : Tracker.matches-state == "cached" ? "neutral" : "off";
                    pad-x: 7px;
                    pad-y: 1px;
                }
            }
        }
    }

    Card {
        pad: 0px;
        gap: 0px;

        // Header row.
        Rectangle {
            height: 34px;
            background: transparent;

            HorizontalLayout {
                padding-left: Space.md;
                padding-right: Space.md;
                spacing: Space.md;

                ColumnLabel { col-width: 66px; text: "DATE"; }
                ColumnLabel { col-width: 108px; text: "MODE"; }
                ColumnLabel { col-width: 150px; text: "MAP"; }
                ColumnLabel { col-width: 74px; text: "RESULT"; }
                ColumnLabel { col-width: 110px; text: "AGENT"; }
                ColumnLabel { col-width: 104px; text: "K / D / A"; }
                ColumnLabel { col-width: 72px; text: "DDΔ"; }
                ColumnLabel { col-width: 76px; text: "SCORE"; }
                ColumnLabel { col-width: 62px; text: "ROUNDS"; }
            }
        }

        if Tracker.matches.length == 0: Rectangle {
            height: 120px;
            background: transparent;

            Text {
                text: Tracker.matches-state == "error"
                    ? "No matches could be read, and none are saved yet."
                    : "No matches yet.";
                font-family: Theme.font-body;
                font-size: TypeScale.caption;
                color: Theme.ink-faint;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        for entry in Tracker.matches: MatchLine { item: entry; }
    }
}
