// Matches tab: the TRN-website history — a top-3 agent strip, a recent-form
// strip, then one group per day (header aggregates plus that day's rows).
// Every cell is pre-formatted by Rust (`MatchAgentUi` / `MatchDayUi` /
// `MatchRowUi`), so this view cannot round, re-derive or invent a value. TRS, clutch and placement chips render only what the payload
// reported; weapon stats have no source, so no panel shows them here either.
//
// A row click opens the scoreboard in place (`Tracker.select-match(id)`): the
// detail view replaces the table, Back clears the selection and the table
// returns — there is no separate tab. Loading reads "Reading match…", a fetch
// failure is an inline error card with a retry, never a blank view.

import { Theme, Space, Shape, TypeScale, Motion } from "tokens.slint";
import { Tracker, MatchRowUi, MatchPlayerUi, MatchRoundUi, MatchAgentUi, MatchDayUi, MatchSummaryUi } from "../state.slint";
import { Card, Cell, ColumnLabel, VCenter, Glyph } from "widgets.slint";

component StatChip inherits Rectangle {
    in property <string> text;
    in property <brush> chip-ink: Theme.ink;
    in property <length> chip-width: 76px;
    width: root.chip-width;
    height: 24px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.line-soft;
    Text {
        text: root.text;
        font-family: Theme.font-mono;
        font-size: TypeScale.micro;
        font-weight: 600;
        color: root.chip-ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

/// The TRS grade badge: Tracker Network draws its own tier mark beside the
/// label, and these are the same six medallions the Tracker Score card ships.
component TrsBadge inherits Rectangle {
    in property <string> grade: "";
    width: 32px;
    height: 32px;

    if root.grade == "1K": Image { source: @image-url("../assets/badges/score-1k.svg"); width: 32px; height: 32px; image-fit: contain; }
    if root.grade == "S": Image { source: @image-url("../assets/badges/score-s.svg"); width: 32px; height: 32px; image-fit: contain; }
    if root.grade == "A": Image { source: @image-url("../assets/badges/score-a.svg"); width: 32px; height: 32px; image-fit: contain; }
    if root.grade == "B": Image { source: @image-url("../assets/badges/score-b.svg"); width: 32px; height: 32px; image-fit: contain; }
    if root.grade == "C": Image { source: @image-url("../assets/badges/score-c.svg"); width: 32px; height: 32px; image-fit: contain; }
    if root.grade == "D": Image { source: @image-url("../assets/badges/score-d.svg"); width: 32px; height: 32px; image-fit: contain; }
}

/// TRS cell, TRN's own shape: the grade badge, then `TRS` over the number.
component TrsCell inherits Rectangle {
    in property <string> grade: "";
    in property <string> value: "";
    width: 96px;
    height: 44px;

    HorizontalLayout {
        spacing: 6px;
        alignment: center;

        VCenter { TrsBadge { grade: root.grade; } }

        VerticalLayout {
            horizontal-stretch: 1;
            height: 36px;
            spacing: 0px;

            Text {
                height: 12px;
                text: "TRS";
                font-family: Theme.font-body;
                font-size: TypeScale.micro;
                font-weight: 500;
                color: Theme.ink-faint;
                vertical-alignment: center;
            }
            Text {
                height: 22px;
                text: root.value == "" ? "—" : root.value;
                font-family: Theme.font-mono;
                font-size: TypeScale.value;
                font-weight: 700;
                color: Theme.ink;
                vertical-alignment: center;
            }
        }
    }
}

/// One numeric column, TRN's own shape: a micro label stacked with its value.
/// `flip` puts the value on top (the day band's K/D/A column, where the triple
/// sits over its ratio). One component, one set of widths — a band and its rows
/// can never drift apart again.
component StatCell inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <brush> ink: Theme.ink;
    in property <length> col-width: 52px;
    in property <bool> flip: false;
    // Drawn faint beside the value ("K/D/A" after the day's ratio).
    in property <string> suffix: "";
    width: root.col-width;

    VerticalLayout {
        spacing: 1px;
        alignment: center;

        if !root.flip: Text {
            text: root.label == "" ? "—" : root.label;
            font-family: Theme.font-body;
            font-size: TypeScale.micro;
            font-weight: 500;
            color: Theme.ink-faint;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                text: root.value == "" ? "—" : root.value;
                font-family: Theme.font-mono;
                font-size: TypeScale.value;
                font-weight: 700;
                color: root.value == "" ? Theme.ink-dim : root.ink;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.suffix != "": Text {
                text: root.suffix;
                font-family: Theme.font-mono;
                font-size: TypeScale.value;
                font-weight: 700;
                color: Theme.ink-faint;
                vertical-alignment: center;
            }
        }
        if root.flip: Text {
            text: root.label == "" ? "—" : root.label;
            font-family: Theme.font-body;
            font-size: TypeScale.micro;
            font-weight: 500;
            color: Theme.ink-faint;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component MatchLine inherits Rectangle {
    in property <MatchRowUi> item;
    // The reference's row panel, measured from the live DOM: 72 px tall,
    // 8 px radius, a 1 px raised border, and a 10 px gap between panels.
    // Each match is its own card, not a stripe in a table.
    height: 72px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.container-high;
    background: line-touch.has-hover ? Theme.container-high : Theme.container;
    animate background { duration: Motion.fast; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.item.agent + " " + root.item.age + " " + root.item.map + " " + root.item.score + " " + root.item.trs + " " + root.item.clutch;
    accessible-action-default => { line-touch.clicked(); }

    line-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Tracker.select-match(root.item.id); }
    }

    // The result spine: the row's verdict readable before any number.
    Rectangle {
        x: 0;
        y: 10px;
        width: 4px;
        height: parent.height - 20px;
        border-radius: 2px;
        background: root.item.won ? Theme.mint : Theme.coral;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: Space.sm;
        spacing: 4px;

        // Agent portrait: the row's own face, like the desktop client. The
        // tinted plate is the fallback floor when the catalogue missed.
        VCenter {
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 9px;
                background: Theme.primary-deep;
                clip: true;

                if root.item.art.width > 0: Image {
                    source: root.item.art;
                    width: 48px;
                    height: 48px;
                    image-fit: contain;
                }
                if root.item.art.width == 0: Glyph {
                    kind: "user";
                    size: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    stroke: Theme.primary;
                    opacity: 0.7;
                }
            }
        }

        // Age + mode over map: one moment, two lines, the website's own
        // stacking. Wide enough that "2d ago // Competitive" never elides.
        VerticalLayout {
            width: 146px;
            spacing: 2px;

            Text {
                text: root.item.age == "" ? "—" : root.item.age;
                font-family: Theme.font-body;
                font-size: TypeScale.micro;
                color: Theme.ink-faint;
                vertical-alignment: center;
                overflow: elide;
            }
            // The name sizes to its own text (no fixed width), so the chip
            // hugs it instead of floating at a fixed offset.
            HorizontalLayout {
                height: 20px;
                vertical-stretch: 0;
                // start-aligned: children take their preferred width, so the
                // chip sits right after the name instead of at the column edge.
                alignment: start;
                spacing: 6px;

                Text {
                    vertical-stretch: 0;
                    // Preferred width, not the column's: the chip must hug the
                    // name instead of sitting at the column's right edge.
                    horizontal-stretch: 0;
                    text: root.item.map == "" ? "—" : root.item.map;
                    font-family: Theme.font-body;
                    font-size: TypeScale.caption;
                    font-weight: 700;
                    color: Theme.ink;
                    vertical-alignment: center;
                }
                if root.item.placement != "": Rectangle {
                    vertical-stretch: 0;
                    horizontal-stretch: 0;
                    width: 28px;
                    height: 20px;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: Theme.line;

                    Text {
                        text: root.item.placement;
                        font-family: Theme.font-body;
                        font-size: TypeScale.micro;
                        font-weight: 600;
                        color: Theme.ink-dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // The rounds score: a micro label over the verdict, stacked exactly
        // like the TRS cell beside it.
        VCenter {
            VerticalLayout {
                spacing: 0px;
                alignment: center;

                Text {
                    text: "Score";
                    font-family: Theme.font-body;
                    font-size: TypeScale.micro;
                    font-weight: 500;
                    color: Theme.ink-faint;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                // TRN colours the sides, not the result: our rounds mint,
                // the opponent's coral, in a loss as well as a win.
                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;

                    Text {
                        text: root.item.score-won == "" ? "—" : root.item.score-won;
                        font-family: Theme.font-mono;
                        font-size: TypeScale.value;
                        font-weight: 700;
                        color: Theme.mint;
                        vertical-alignment: center;
                    }
                    Text {
                        text: ":";
                        font-family: Theme.font-mono;
                        font-size: TypeScale.value;
                        font-weight: 700;
                        color: Theme.ink-faint;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.item.score-lost == "" ? "—" : root.item.score-lost;
                        font-family: Theme.font-mono;
                        font-size: TypeScale.value;
                        font-weight: 700;
                        color: Theme.coral;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // TRS: the grade badge plus the score, TRN's own cell shape.
        VCenter {
            TrsCell {
                grade: root.item.trs-grade;
                value: root.item.trs;
            }
        }
        // Clutch badge: the payload reports these sparsely, so the slot keeps
        // its width on rows without one and the tail never shifts.
        VCenter {
            Rectangle {
                width: 86px;
                height: 24px;

                if root.item.clutch != "": StatChip {
                    text: root.item.clutch;
                    chip-width: 86px;
                    // Signed by the tone itself: a lost clutch is the bad case.
                    chip-ink: root.item.clutch-bad ? Theme.coral : Theme.mint;
                }
            }
        }
        // The slack lives BEFORE the tail: the numeric block then ends on the
        // card's right edge, which is the edge every day band ends on.
        Rectangle { horizontal-stretch: 1; }

        // TRN's own column order: K/D, then the K/D/A triple, then DDΔ, HS %
        // and ACS. Every column is a StatCell — the day band reuses them, so
        // no widths are repeated anywhere else in this file.
        HorizontalLayout {
            spacing: 10px;

            StatCell { col-width: 54px; label: "K/D"; value: root.item.kd; ink: Theme.ink; }
            StatCell { col-width: 150px; label: "K/D/A"; value: root.item.kda; ink: Theme.ink; }
            StatCell { col-width: 64px; label: "DDΔ"; value: root.item.dd; ink: root.item.dd == "" ? Theme.ink-dim : (root.item.dd.starts-with("-") ? Theme.coral : Theme.mint); }
            StatCell { col-width: 56px; label: "HS %"; value: root.item.hs; ink: Theme.ink; }
            StatCell { col-width: 56px; label: "ACS"; value: root.item.acs; ink: Theme.ink; }
        }
    }
}

/// One agent cell of the top strip, TRN-shaped: portrait, name, the season
/// record, the agent's K/D and a bar whose width is the reported win share.
/// The number is Rust's string; the bar only reads the share.
component AgentCell inherits Rectangle {
    in property <MatchAgentUi> item;
    horizontal-stretch: 1;
    min-width: 150px;
    height: 60px;

    HorizontalLayout {
        spacing: Space.sm;

        // Portrait: the agent's own face. The tinted plate is the fallback
        // floor when the catalogue missed.
        VCenter {
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 8px;
                background: Theme.primary-deep;
                clip: true;

                if root.item.art.width > 0: Image {
                    source: root.item.art;
                    width: 40px;
                    height: 40px;
                    image-fit: contain;
                }
                if root.item.art.width == 0: Glyph {
                    kind: "user";
                    size: 18px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    stroke: Theme.primary;
                    opacity: 0.7;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            alignment: center;

            Text {
                text: root.item.name == "" ? "—" : root.item.name;
                font-family: Theme.font-body;
                font-size: TypeScale.caption;
                font-weight: 700;
                color: Theme.ink;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.item.record == "" ? "—" : root.item.record;
                font-family: Theme.font-body;
                font-size: TypeScale.micro;
                color: Theme.ink-dim;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.item.kd == "" ? "K/D —" : "K/D " + root.item.kd;
                font-family: Theme.font-mono;
                font-size: TypeScale.micro;
                color: Theme.ink-faint;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                height: 3px;
                border-radius: 1.5px;
                background: Theme.line;

                Rectangle {
                    x: 0;
                    width: parent.width * Math.min(Math.max(root.item.win-share, 0), 1);
                    height: parent.height;
                    border-radius: 1.5px;
                    background: root.item.win-share >= 0.5 ? Theme.mint : Theme.coral;
                }
            }
        }
    }
}

/// The season cell at the left of the strip: TRN prints the whole-season
/// record on the first line, `K/D | ADR` under it, then the same bar.
component SeasonCell inherits Rectangle {
    in property <MatchSummaryUi> item;
    width: 200px;
    height: 62px;
    border-radius: Shape.sm;
    background: Theme.container-high;

    VerticalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: 2px;
        alignment: center;

        Text {
            text: root.item.record == "" ? "—" : root.item.record;
            font-family: Theme.font-body;
            font-size: TypeScale.title;
            font-weight: 700;
            color: Theme.mint;
            overflow: elide;
        }
        Text {
            text: (root.item.kd == "" ? "K/D —" : root.item.kd)
                + (root.item.adr == "" ? "" : " | " + root.item.adr);
            font-family: Theme.font-mono;
            font-size: TypeScale.micro;
            color: Theme.mint;
            opacity: 0.75;
            overflow: elide;
        }
        Rectangle {
            height: 3px;
            border-radius: 1.5px;
            background: Theme.line;

            Rectangle {
                x: 0;
                width: parent.width * Math.min(Math.max(root.item.win-share, 0), 1);
                height: parent.height;
                border-radius: 1.5px;
                background: root.item.win-share >= 0.5 ? Theme.mint : Theme.coral;
            }
        }
    }
}

component DayHeader inherits Rectangle {
    in property <MatchDayUi> item;
    // Reference band: 54 px and rounded, the date at 18 px/700 in the
    // secondary ink, the W/L verdict in the middle, then the day's totals over
    // the columns they total. No numeric label is repeated down here.
    height: 54px;
    border-radius: 8px;
    background: Theme.container-low;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: Space.sm;
        spacing: 4px;

        VCenter {
            Text {
                text: root.item.title == "" ? "—" : root.item.title;
                font-family: Theme.font-body;
                font-size: TypeScale.value;
                font-weight: 700;
                color: Theme.ink-dim;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // The match count is a chip, not "[3]" in the date.
        VCenter {
            Rectangle {
                width: 30px;
                height: 24px;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.line;
                background: transparent;

                Text {
                    text: root.item.count-label == "" ? "—" : root.item.count-label;
                    font-family: Theme.font-body;
                    font-size: TypeScale.caption;
                    font-weight: 700;
                    color: Theme.ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        // The verdict in two colours: wins read mint, losses read coral.
        VCenter {
            HorizontalLayout {
                spacing: 6px;

                Text {
                    text: root.item.wins-label;
                    font-family: Theme.font-body;
                    font-size: TypeScale.value;
                    font-weight: 700;
                    color: Theme.mint;
                    vertical-alignment: center;
                }
                Text {
                    text: "//";
                    font-family: Theme.font-body;
                    font-size: TypeScale.value;
                    font-weight: 700;
                    color: Theme.ink-faint;
                    vertical-alignment: center;
                }
                Text {
                    text: root.item.losses-label;
                    font-family: Theme.font-body;
                    font-size: TypeScale.value;
                    font-weight: 700;
                    color: Theme.coral;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        // Two chip-width spacers stand in for the rows' TRS/clutch slots, then
        // the same shared tail as every row: one component, one set of widths.
        Rectangle { width: 96px; }
        Rectangle { width: 86px; }
        HorizontalLayout {
            spacing: 10px;

            StatCell { col-width: 54px; label: "K/D"; value: root.item.kd; ink: Theme.ink; }
            StatCell {
                col-width: 150px;
                label: root.item.kda;
                value: root.item.kda_sub == "" ? "" : root.item.kda_sub;
                suffix: root.item.kda_sub == "" ? "" : "K/D/A";
                ink: Theme.ink;
            }
            StatCell { col-width: 64px; label: "DDΔ"; value: root.item.dda; ink: root.item.dda == "" ? Theme.ink-dim : (root.item.dda.starts-with("-") ? Theme.coral : Theme.mint); }
            StatCell { col-width: 56px; label: "HS %"; value: root.item.hs; ink: Theme.ink; }
            StatCell { col-width: 56px; label: "ACS"; value: root.item.acs; ink: Theme.ink; }
        }
    }

}

component DetailPlayerLine inherits Rectangle {
    in property <MatchPlayerUi> item;
    height: 44px;
    background: transparent;

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.sm;

        VCenter {
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 7px;
                background: Theme.primary-deep;
                clip: true;

                if root.item.art.width > 0: Image {
                    source: root.item.art;
                    width: 28px;
                    height: 28px;
                    image-fit: contain;
                }
                if root.item.art.width == 0: Glyph {
                    kind: "user";
                    size: 13px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    stroke: Theme.primary;
                    opacity: 0.7;
                }
            }
        }

        // Name over rank: one player, two lines.
        VerticalLayout {
            width: 150px;
            spacing: 1px;

            Text {
                text: root.item.name == "" ? "—" : root.item.name;
                font-family: Theme.font-body;
                font-size: TypeScale.caption;
                font-weight: 600;
                color: Theme.ink;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.item.rank == "" ? "—" : root.item.rank;
                font-family: Theme.font-body;
                font-size: TypeScale.micro;
                color: Theme.ink-faint;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Cell { col-width: 72px; value: root.item.agent; }
        Cell { col-width: 48px; value: root.item.acs; mono: true; align-right: true; }
        Cell { col-width: 92px; value: root.item.kda; mono: true; align-right: true; }
        Cell { col-width: 48px; value: root.item.kd; mono: true; align-right: true; }
        Cell { col-width: 56px; value: root.item.hs; mono: true; align-right: true; }
        Cell { col-width: 56px; value: root.item.kast; mono: true; align-right: true; }
        Cell {
            col-width: 58px;
            value: root.item.dd;
            mono: true;
            align-right: true;
            ink: root.item.dd == ""
                ? Theme.ink-dim
                : root.item.dd.starts-with("-") ? Theme.coral : Theme.mint;
        }
        Rectangle { horizontal-stretch: 1; }
    }

    Rectangle {
        x: Space.md;
        y: parent.height - 1px;
        width: parent.width - Space.md * 2;
        height: 1px;
        background: Theme.line-soft;
    }
}

component TeamCard inherits VerticalLayout {
    in property <string> title: "";
    in property <bool> won: false;
    in property <[MatchPlayerUi]> rows: [];

    Card {
        pad: 0px;
        gap: 0px;

        Rectangle {
            height: 34px;
            background: transparent;

            HorizontalLayout {
                padding-left: Space.md;
                padding-right: Space.md;
                spacing: Space.sm;

                ColumnLabel { col-width: 28px; text: ""; }
                ColumnLabel { col-width: 150px; text: root.title; }
                ColumnLabel { col-width: 72px; text: "AGENT"; }
                ColumnLabel { col-width: 48px; text: "ACS"; align-right: true; }
                ColumnLabel { col-width: 92px; text: "K / D / A"; align-right: true; }
                ColumnLabel { col-width: 48px; text: "K/D"; align-right: true; }
                ColumnLabel { col-width: 56px; text: "HS %"; align-right: true; }
                ColumnLabel { col-width: 56px; text: "KAST"; align-right: true; }
                ColumnLabel { col-width: 64px; text: "DDΔ"; align-right: true; }
            }
        }

        for player in root.rows: DetailPlayerLine { item: player; }
    }
}

component RoundCell inherits Rectangle {
    in property <MatchRoundUi> item;
    callback tapped(string);
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: root.item.blue ? Theme.mint : Theme.coral;
    accessible-role: button;
    accessible-label: root.item.tip;

    Text {
        text: root.item.label;
        font-family: Theme.font-mono;
        font-size: TypeScale.micro;
        font-weight: 700;
        color: Theme.surface-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.tapped(root.item.tip); }
        mouse-cursor: pointer;
    }
}

export component MatchesPage inherits VerticalLayout {
    // Same page box as Overview/Agents/Maps/Live.
    padding-left: Space.xl;
    padding-right: Space.xl;
    padding-top: 20px;
    padding-bottom: 20px;
    spacing: Space.md;

    // The tapped round's result line: the colour is never the only signal.
    property <string> round-tip: "";

    if Tracker.match-id == "": VerticalLayout {
        spacing: Space.md;

        // Top strip, TRN-shaped: the season summary on the left, then the
        // three most-played agents spread across the rest of the row.
        if Tracker.match-agents.length > 0: Card {
            HorizontalLayout {
                padding-left: Space.md;
                padding-right: Space.md;
                padding-top: Space.sm;
                padding-bottom: Space.sm;
                spacing: Space.md;

                SeasonCell { item: Tracker.match-summary; }
                for agent in Tracker.match-agents: AgentCell { item: agent; }
            }
        }

        // The match list body, measured from the live client: #0F1923 body at
        // radius 16 with a 1 px border and 14/16 px padding. The day bands and
        // the match panels live INSIDE it, which is what makes the panels read
        // as cards rather than stripes.
        Rectangle {
            border-radius: 16px;
            background: Theme.container-low;
            border-width: 1px;
            border-color: Theme.container-high;

            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 10px;

            if Tracker.match-days.length == 0: Rectangle {
                height: 120px;
                background: transparent;

                // The band is gone by design: the reason lives here, in the empty
                // card, instead of a strip above the table.
                Text {
                    text: Tracker.matches-note == "" ? "No matches yet." : Tracker.matches-note;
                    font-family: Theme.font-body;
                    font-size: TypeScale.caption;
                    color: Theme.ink-faint;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // One group per day: the band, then its match panels 10 px apart
            // (the reference's own gap), then 10 px before the next band.
            for day[i] in Tracker.match-days: VerticalLayout {
                spacing: 0px;

                DayHeader { item: day; }
                Rectangle { height: 10px; background: transparent; }
                VerticalLayout {
                    spacing: 10px;

                    // No side inset: the reference's panels and its band share
                    // one left and right edge, so every numeric column lines up.
                    for entry in Tracker.match-day-rows[i]: MatchLine { item: entry; }
                }
                Rectangle { height: 10px; background: transparent; }
            }
            }
        }
    }

    if Tracker.match-id != "": VerticalLayout {
        spacing: Space.md;

        // Header strip: Back, then map + mode + date + duration, then the
        // Blue X – Y Red score the rounds voted for.
        Card {
            HorizontalLayout {
                padding-left: Space.md;
                padding-right: Space.md;
                padding-top: Space.sm;
                padding-bottom: Space.sm;
                spacing: Space.md;

                back-touch := TouchArea {
                    clicked => { Tracker.close-match-detail(); }
                    mouse-cursor: pointer;
                }
                VCenter {
                    Text {
                        text: "‹ Back";
                        accessible-role: button;
                        accessible-label: "Back to matches";
                        accessible-action-default => { back-touch.clicked(); };
                        font-family: Theme.font-body;
                        font-size: TypeScale.caption;
                        font-weight: 600;
                        color: back-touch.has-hover ? Theme.ink : Theme.primary;
                    }
                }
                VCenter {
                    VerticalLayout {
                        spacing: 1px;
                        Text {
                            text: Tracker.match-title == "" ? "—" : Tracker.match-title;
                            font-family: Theme.font-body;
                            font-size: TypeScale.caption;
                            font-weight: 700;
                            color: Theme.ink;
                            overflow: elide;
                        }
                        if root.round-tip != "": Text {
                            text: root.round-tip;
                            font-family: Theme.font-body;
                            font-size: TypeScale.micro;
                            color: Theme.ink-faint;
                            overflow: elide;
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                VCenter {
                    Text {
                        text: Tracker.match-score == "" ? "—" : Tracker.match-score;
                        font-family: Theme.font-mono;
                        font-size: TypeScale.body;
                        font-weight: 700;
                        color: Theme.ink;
                    }
                }
            }
        }

        if Tracker.match-state == "loading": Card {
            Rectangle {
                height: 120px;
                background: transparent;
                Text {
                    text: "Reading match…";
                    font-family: Theme.font-body;
                    font-size: TypeScale.caption;
                    color: Theme.ink-faint;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if Tracker.match-state == "error": Card {
            VerticalLayout {
                padding-left: Space.md;
                padding-right: Space.md;
                padding-top: Space.md;
                padding-bottom: Space.md;
                spacing: Space.sm;
                Text {
                    text: Tracker.match-note == "" ? "The scoreboard did not load." : Tracker.match-note;
                    font-family: Theme.font-body;
                    font-size: TypeScale.caption;
                    color: Theme.coral;
                    wrap: word-wrap;
                }
                retry-touch := TouchArea {
                    clicked => { Tracker.select-match(Tracker.match-id); }
                    mouse-cursor: pointer;
                }
                Text {
                    text: "Retry";
                    accessible-role: button;
                    accessible-label: "Retry loading match";
                    accessible-action-default => { retry-touch.clicked(); };
                    font-family: Theme.font-body;
                    font-size: TypeScale.caption;
                    font-weight: 600;
                    color: retry-touch.has-hover ? Theme.ink : Theme.primary;
                }
            }
        }

        if Tracker.match-state == "ready": VerticalLayout {
            spacing: Space.md;

            TeamCard {
                title: Tracker.match-blue-won ? "Blue — Victory" : "Blue";
                won: Tracker.match-blue-won;
                rows: Tracker.match-blue;
            }
            TeamCard {
                title: Tracker.match-red-won ? "Red — Victory" : "Red";
                won: Tracker.match-red-won;
                rows: Tracker.match-red;
            }

            // Rounds strip: one cell per round, coloured by the winner. The
            // result names each cell to screen readers (`accessible-label`)
            // and a tap lands it in the header line above.
            Card {
                VerticalLayout {
                    padding-left: Space.md;
                    padding-right: Space.md;
                    padding-top: Space.sm;
                    padding-bottom: Space.sm;
                    spacing: Space.sm;
                    HorizontalLayout {
                        spacing: 4px;
                        for r in Tracker.match-rounds: RoundCell {
                            item: r;
                            tapped(tip) => { root.round-tip = tip; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text {
                        text: "Each cell is one round — tap it for the result.";
                        font-family: Theme.font-body;
                        font-size: TypeScale.micro;
                        color: Theme.ink-faint;
                    }
                }
            }
        }
    }
}
