// Shared app chrome. Same visual family as the HUD: tokens only, no blur,
// layered translucent plates and 1px inner strokes.

import { Theme, TypeScale, Space, Shape, Motion } from "tokens.slint";

export component Chip inherits Rectangle {
    in property <string> text: "";
    // neutral | live | armed | error | off
    in property <string> tone: "neutral";

    height: label.height + 8px;
    width: label.width + 18px;
    border-radius: Shape.pill;
    background: tone == "live"
        ? #a8f5cc1f
        : tone == "armed"
            ? #e8b73a1f
            : tone == "error"
                ? #ffb4ab1f
                : tone == "off"
                    ? #ffffff0d
                    : #d0bcff1a;
    border-width: 1px;
    border-color: tone == "live"
        ? #a8f5cc59
        : tone == "armed"
            ? #e8b73a59
            : tone == "error"
                ? #ffb4ab59
                : #ffffff14;

    label := Text {
        x: 9px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        font-family: Theme.font-mono;
        font-size: TypeScale.micro;
        font-weight: 700;
        letter-spacing: 0.6px;
        color: tone == "live"
            ? Theme.mint
            : tone == "armed"
                ? Theme.amber
                : tone == "error"
                    ? Theme.error
                    : Theme.ink-dim;
    }
}

export component StateDot inherits Rectangle {
    in property <string> tone: "neutral";
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: tone == "ok" || tone == "live"
        ? Theme.mint
        : tone == "warn" || tone == "armed"
            ? Theme.amber
            : tone == "error" || tone == "unsupported"
                ? Theme.coral
                : Theme.ink-faint;
}

/// Leading glyph for a nav row. Four stroke paths on Lucide's 24x24 grid,
/// scaled by the view box: no icon font, no image asset, no new dependency.
/// `kind`: tracker (reticle) | overlay (stacked plates) | settings (sliders) |
/// stretch (corner arrows).
export component NavGlyph inherits Path {
    in property <string> kind: "tracker";

    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke-width: 2px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    commands: kind == "tracker"
        ? "M 12 2 A 10 10 0 1 1 12 22 A 10 10 0 1 1 12 2 M 22 12 H 18 M 6 12 H 2 M 12 6 V 2 M 12 22 V 18"
        : kind == "overlay"
            ? "M 12 2.75 L 21 7.25 L 12 11.75 L 3 7.25 Z M 3 12.75 L 12 17.25 L 21 12.75 M 3 17.75 L 12 22.25 L 21 17.75"
            : kind == "settings"
                ? "M 21 4 H 14 M 10 4 H 3 M 14 2 V 6 M 21 12 H 12 M 8 12 H 3 M 8 10 V 14 M 21 20 H 16 M 12 20 H 3 M 16 18 V 22"
                : "M 15 3 H 21 V 9 M 9 21 H 3 V 15 M 21 3 L 14 10 M 3 21 L 10 14";
}

/// Sidebar navigation row: a real button, so it must read as one at rest.
/// The row is a recessed slot (surface fill + hairline) that lifts to a filled
/// plate on hover, brighter on press, and shows a violet edge, spine and glyph
/// when current. Space/Return activates; Tab focus draws a 2px ring inside the
/// plate. A `soon` row keeps the same footprint but stays hollow: ghost
/// outline, faint glyph and label, SOON chip, no hover, no focus, no click.
export component NavRow inherits Rectangle {
    in property <string> label: "";
    in property <string> glyph: "tracker";
    in property <bool> active: false;
    in property <bool> soon: false;
    out property <bool> has-focus: scope.has-focus;
    out property <bool> hovered: !root.soon && touch.has-hover;
    // Held down on the row: a press dragged off the row is not a press.
    out property <bool> pressing: root.hovered && touch.pressed;
    callback clicked();

    height: 40px;
    border-radius: Shape.sm;
    border-width: Shape.stroke;
    border-color: root.soon
        ? Theme.line-soft
        : root.active
            ? Theme.primary-dim
            : root.hovered || root.pressing
                ? Theme.line
                : Theme.line-soft;
    // Rest is one step below the rail so the row reads as a slot, not a label;
    // hover/active/press climb toward the HUD's container scale.
    background: root.soon
        ? transparent
        : root.pressing
            ? Theme.container-highest
            : root.active
                ? Theme.container-high
                : root.hovered
                    ? Theme.container
                    : Theme.surface;
    animate background { duration: Motion.fast; easing: ease-out; }
    animate border-color { duration: Motion.fast; easing: ease-out; }

    accessible-role: button;
    accessible-enabled: !root.soon;
    accessible-label: root.label;
    accessible-action-default => { touch.clicked(); }

    // Pointer cursor over the whole row, including the padding.
    touch := TouchArea {
        enabled: !root.soon;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    scope := FocusScope {
        x: 0;
        width: 0; // Tab-focusable, but clicks must not land here.
        enabled: !root.soon;

        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }

    // Keyboard focus ring: 2px inset, no layout shift, state border kept.
    if root.has-focus && !root.soon: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: Shape.sm - 1px;
        border-width: 2px;
        border-color: Theme.primary;
        background: transparent;
    }

    // Active accent spine, same 2px as the HUD's live spine.
    if root.active: Rectangle {
        x: 0px;
        y: 10px;
        width: 2px;
        height: parent.height - 20px;
        border-radius: 2px;
        background: Theme.primary;
    }

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.sm;

        NavGlyph {
            kind: root.glyph;
            stroke: root.soon
                ? Theme.line
                : root.active
                    ? Theme.primary
                    : root.hovered
                        ? Theme.ink
                        : Theme.ink-faint;
            animate stroke { duration: Motion.fast; easing: ease-out; }
        }
        Text {
            text: root.label;
            font-family: Theme.font-body;
            font-size: TypeScale.body;
            font-weight: root.active ? 700 : 500;
            color: root.active
                ? Theme.ink
                : root.soon
                    ? Theme.ink-faint
                    : root.hovered
                        ? Theme.ink
                        : Theme.ink-dim;
            vertical-alignment: center;
            horizontal-stretch: 1;
            animate color { duration: Motion.fast; easing: ease-out; }
        }
        if root.soon: Chip {
            text: "SOON";
            tone: "off";
        }
    }
}

export component HudToggle inherits Rectangle {
    in property <bool> checked: false;
    callback toggled();

    width: 46px;
    height: 26px;
    border-radius: 13px;
    background: checked ? #d0bcff33 : Theme.container-high;
    border-width: 1px;
    border-color: checked ? Theme.primary : Theme.line;

    knob := Rectangle {
        x: checked ? parent.width - self.width - 4px : 4px;
        y: 4px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: checked ? Theme.primary : Theme.ink-faint;
        animate x { duration: Motion.fast; easing: ease-in-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line-soft;
}

/// Small mono section label. One definition for every panel in the app.
export component PanelTitle inherits Text {
    text: "";
    font-family: Theme.font-mono;
    font-size: TypeScale.micro;
    font-weight: 700;
    letter-spacing: 1.4px;
    color: Theme.ink-faint;
}

/// Body copy for panels: wraps, never shouts.
export component Caption inherits Text {
    text: "";
    font-family: Theme.font-body;
    font-size: TypeScale.caption;
    color: Theme.ink-faint;
    wrap: word-wrap;
}

/// Small text button (rank refresh). Disabled colour when `enabled` is false.
export component LinkButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> enabled: true;
    callback clicked();

    height: label.height + 8px;
    width: label.width + 16px;
    border-radius: Shape.pill;
    background: hover.has-hover && enabled ? #ffffff10 : transparent;
    border-width: 1px;
    border-color: enabled ? Theme.line : transparent;

    label := Text {
        x: 8px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        font-family: Theme.font-mono;
        font-size: TypeScale.micro;
        font-weight: 700;
        letter-spacing: 0.6px;
        color: enabled ? Theme.primary : Theme.ink-faint;
    }

    hover := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
