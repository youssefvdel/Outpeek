// Shared shell chrome. One token set, no hex literals in this file: every
// colour comes from Theme, every stroke size from Shape.
//
// The language is the shipping Recon shell: flat rows that fill only when
// selected, 1px hairlines instead of stacks of shadows, mono eyebrows over
// display numerals. Nothing here blurs or overlays the game.

import { Theme, TypeScale, Space, Shape, Motion } from "tokens.slint";
import {
    IconChevronDown, IconCopy, IconCpu, IconCrosshair, IconMessageSquare, IconMinus,
    IconMonitor, IconRefreshCw, IconSettings, IconShieldCheck, IconShoppingBag,
    IconSquare, IconTrendingUp, IconUserCheck, IconUsers, IconX,
} from "icons.slint";

/// Status pill. `tone`: neutral | live | armed | error | off.
/// `pad-x` / `pad-y` let a dense row use a flatter chip without a second
/// component; the type size stays on the 11px floor.
export component Chip inherits Rectangle {
    in property <string> text: "";
    in property <string> tone: "neutral";
    in property <length> pad-x: 9px;
    in property <length> pad-y: 2px;

    height: label.height + root.pad-y * 2;
    width: label.width + root.pad-x * 2;
    border-radius: Shape.pill;
    background: tone == "live"
        ? Theme.mint-wash
        : tone == "armed"
            ? Theme.amber-wash
            : tone == "error"
                ? Theme.coral-wash
                : tone == "off"
                    ? Theme.neutral-wash
                    : Theme.primary-wash;
    border-width: Shape.stroke;
    border-color: tone == "live"
        ? Theme.mint-edge
        : tone == "armed"
            ? Theme.amber-edge
            : tone == "error"
                ? Theme.coral-edge
                : tone == "off"
                    ? Theme.neutral-edge
                    : Theme.primary-edge;

    label := Text {
        x: root.pad-x;
        y: (parent.height - self.height) / 2;
        text: root.text;
        font-family: Theme.font-mono;
        font-size: TypeScale.micro;
        font-weight: 700;
        letter-spacing: 0.6px;
        color: tone == "live"
            ? Theme.mint
            : tone == "armed"
                ? Theme.amber
                : tone == "error"
                    ? Theme.error
                    : Theme.ink-dim;
    }
}

export component StateDot inherits Rectangle {
    in property <string> tone: "neutral";
    width: 7px;
    height: 7px;
    border-radius: 3.5px;
    background: tone == "ok" || tone == "live"
        ? Theme.mint
        : tone == "warn" || tone == "armed"
            ? Theme.amber
            : tone == "error" || tone == "unsupported"
                ? Theme.coral
                : Theme.ink-faint;
}

/// Cross-axis centering for a fixed-size child inside a layout. Slint layouts
/// align fixed children at the start of the cross axis; `alignment` only
/// distributes the main axis. A one-child layout is the supported way to
/// center on the other axis, so the shell has exactly these two wrappers.
export component VCenter inherits VerticalLayout {
    alignment: center;
    @children
}

export component HCenter inherits HorizontalLayout {
    alignment: center;
    @children
}

/// One component on the shell's own 24-unit grid, for the kinds Lucide does not
/// ship. Same geometry as `LucideIcon` so a legacy glyph and a real icon sit on
/// the same baseline.
component LegacyGlyph inherits Path {
    in property <length> size: 16px;

    width: self.size;
    height: self.size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke-width: 2px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
}

/// Icon slot: the real Lucide geometry from `icons.slint`, selected by the
/// shell's own kind name so rows and buttons stay strings. `stroke` is the icon
/// ink — the container draws no border of its own, so the brush only reaches the
/// path.
///
/// Two kinds have no Lucide source in the shipping set and keep the shell's
/// own paths below: `ranks` (the React app drew rank crests from art, not from
/// lucide) and `user` (the set ships `users` and `user-check`, not a single
/// person). The combat-highlight badges are real artwork now: `cards.slint`
/// draws the PNGs, not a glyph.
export component Glyph inherits Rectangle {
    in property <string> kind: "tracker";
    in property <length> size: 16px;
    in property <brush> stroke: transparent;

    width: root.size;
    height: root.size;
    background: transparent;

    if kind == "tracker": IconTrendingUp { width: parent.width; height: parent.height; stroke: root.stroke; }
    if kind == "store": IconShoppingBag { width: parent.width; height: parent.height; stroke: root.stroke; }
    if kind == "crosshair": IconCrosshair { width: parent.width; height: parent.height; stroke: root.stroke; }
    if kind == "monitor": IconMonitor { width: parent.width; height: parent.height; stroke: root.stroke; }
    if kind == "cpu": IconCpu { width: parent.width; height: parent.height; stroke: root.stroke; }
    if kind == "chat": IconMessageSquare { width: parent.width; height: parent.height; stroke: root.stroke; }
    if kind == "people": IconUserCheck { width: parent.width; height: parent.height; stroke: root.stroke; }
    if kind == "users": IconUsers { width: parent.width; height: parent.height; stroke: root.stroke; }
    if kind == "settings": IconSettings { width: parent.width; height: parent.height; stroke: root.stroke; }
    if kind == "refresh": IconRefreshCw { width: parent.width; height: parent.height; stroke: root.stroke; }
    if kind == "shield": IconShieldCheck { width: parent.width; height: parent.height; stroke: root.stroke; }
    if kind == "chevron-down": IconChevronDown { width: parent.width; height: parent.height; stroke: root.stroke; }
    if kind == "minus": IconMinus { width: parent.width; height: parent.height; stroke: root.stroke; }
    if kind == "square": IconSquare { width: parent.width; height: parent.height; stroke: root.stroke; }
    if kind == "copy": IconCopy { width: parent.width; height: parent.height; stroke: root.stroke; }
    if kind == "x": IconX { width: parent.width; height: parent.height; stroke: root.stroke; }

    if kind == "ranks": LegacyGlyph {
        size: root.size;
        stroke: root.stroke;
        commands: "M 6 14 L 12 8 L 18 14 M 6 19 L 12 13 L 18 19";
    }
    if kind == "user": LegacyGlyph {
        size: root.size;
        stroke: root.stroke;
        commands: "M 19 21 V 19 A 4 4 0 0 0 15 15 H 9 A 4 4 0 0 0 5 19 V 21 M 12 11 A 4 4 0 1 0 12 3 A 4 4 0 1 0 12 11";
    }
}

/// Sidebar navigation row: a real button, flat at rest like the shipping app.
/// Selected = full violet fill + 700 label; hover lifts one container step.
/// `soon` keeps the same footprint, stays hollow, shows a SOON chip and takes
/// no pointer, focus or click. Space/Return activate; Tab draws a 2px ring.
export component NavItem inherits Rectangle {
    in property <string> label: "";
    in property <string> glyph: "tracker";
    in property <bool> active: false;
    in property <bool> soon: false;
    out property <bool> has-focus: scope.has-focus;
    out property <bool> hovered: !root.soon && touch.has-hover;
    callback clicked();

    height: 32px;
    border-radius: Shape.pill;
    background: root.soon
        ? transparent
        : root.active
            ? Theme.primary-dim
            : root.hovered
                ? Theme.container-high
                : transparent;
    animate background { duration: Motion.fast; easing: ease-out; }

    accessible-role: button;
    accessible-enabled: !root.soon;
    accessible-label: root.label;
    accessible-action-default => { touch.clicked(); }

    touch := TouchArea {
        enabled: !root.soon;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    scope := FocusScope {
        x: 0;
        width: 0; // Tab-focusable, but clicks must not land here.
        enabled: !root.soon;

        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }

    if root.has-focus && !root.soon: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: Shape.pill - 1px;
        border-width: 2px;
        border-color: Theme.primary;
        background: transparent;
    }

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.sm;
        // 10 px matches the shipping sidebar's `space-x-2.5`; the pair reads as
        // one row, not an icon with a label bolted on.
        spacing: 10px;

        Glyph {
            kind: root.glyph;
            // The React rail ships `w-4 h-4` = 16 px. 15 px shifted every glyph
            // by half a pixel against the label baseline.
            size: 16px;
            stroke: root.active
                ? Theme.ink
                : root.soon
                    ? Theme.ink-faint
                    : Theme.ink-dim;
            opacity: root.soon ? 0.55 : 1;
        }
        Text {
            text: root.label;
            font-family: root.active ? Theme.font-display : Theme.font-body;
            font-size: TypeScale.caption;
            font-weight: 600;
            color: root.active
                ? Theme.ink
                : root.soon
                    ? Theme.ink-faint
                    : Theme.ink-dim;
            vertical-alignment: center;
            horizontal-stretch: 1;
            opacity: root.soon ? 0.7 : 1;
        }
        if root.soon: VCenter {
            // Seven identical pills read as decoration. The row is already dim
            // and unclickable; one quiet word says the rest.
            Text {
                text: "soon";
                font-family: Theme.font-mono;
                font-size: TypeScale.micro;
                color: Theme.ink-faint;
                opacity: 0.75;
                vertical-alignment: center;
            }
        }
    }
}

export component HudToggle inherits Rectangle {
    in property <bool> checked: false;
    callback toggled();

    width: 46px;
    height: 26px;
    border-radius: 13px;
    background: checked ? Theme.primary-deep : Theme.container-high;
    border-width: 1px;
    border-color: checked ? Theme.primary-dim : Theme.line;

    knob := Rectangle {
        x: checked ? parent.width - self.width - 4px : 4px;
        y: 4px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: checked ? Theme.primary : Theme.ink-faint;
        animate x { duration: Motion.fast; easing: ease-in-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

/// Small square action in the window chrome (refresh, HUD toggle). Focusable
/// and keyboard-activatable: an icon button is still a button.
export component IconButton inherits Rectangle {
    in property <string> glyph: "refresh";
    in property <string> label: "Refresh";
    in property <bool> enabled: true;
    in property <brush> tone: Theme.ink-dim;
    out property <bool> has-focus: scope.has-focus;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: Shape.sm;
    background: root.enabled && touch.has-hover ? Theme.container-high : transparent;
    animate background { duration: Motion.fast; easing: ease-out; }

    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.label;
    accessible-action-default => { touch.clicked(); }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    scope := FocusScope {
        x: 0;
        width: 0;
        enabled: root.enabled;

        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }

    if root.has-focus: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        border-radius: Shape.sm;
        border-width: 2px;
        border-color: Theme.primary;
        background: transparent;
    }

    Glyph {
        kind: root.glyph;
        size: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        stroke: root.enabled ? root.tone : Theme.line;
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line-soft;
}

/// Mono eyebrow. One definition for every section label and table header.
export component PanelTitle inherits Text {
    text: "";
    font-family: Theme.font-mono;
    font-size: TypeScale.micro;
    font-weight: 700;
    letter-spacing: 1.4px;
    color: Theme.ink-faint;
}

/// Table column header. `col-width` is the same number the row cell under it
/// uses, so a header can never drift away from its column.
export component ColumnLabel inherits Text {
    in property <length> col-width: 80px;
    // Numeric columns sit over right-aligned numbers, so their header does too.
    in property <bool> align-right: false;
    width: root.col-width;
    horizontal-alignment: root.align-right ? right : left;
    font-family: Theme.font-body;
    font-size: TypeScale.micro;
    font-weight: 600;
    color: Theme.ink-faint;
    vertical-alignment: center;
    overflow: elide;
}

/// One pre-formatted value in a fixed-width column. An empty string is drawn as
/// an em dash: "not reported", never a zero.
export component Cell inherits Text {
    in property <length> col-width: 80px;
    in property <string> value: "";
    in property <bool> align-right: false;
    in property <brush> ink: Theme.ink-dim;
    in property <int> weight: 500;
    in property <bool> mono: false;
    width: root.col-width;
    text: root.value == "" ? "—" : root.value;
    horizontal-alignment: root.align-right ? right : left;
    font-family: root.mono ? Theme.font-mono : Theme.font-body;
    font-size: TypeScale.caption;
    font-weight: root.weight;
    color: root.ink;
    vertical-alignment: center;
    overflow: elide;
}

/// Win percentage with the 3px share bar beneath it. `value` is the reported
/// string; `share` (0–1) only widths the fill, and its colour only says whether
/// the bar crossed half — no number is derived here.
export component WinCell inherits VerticalLayout {
    in property <length> col-width: 96px;
    in property <string> value: "";
    in property <float> share: 0;
    width: root.col-width;
    spacing: 3px;

    Text {
        text: root.value == "" ? "—" : root.value;
        font-family: Theme.font-body;
        font-size: TypeScale.caption;
        font-weight: 600;
        color: Theme.ink;
        vertical-alignment: center;
    }
    Rectangle {
        width: root.col-width - 14px;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.line;

        Rectangle {
            width: parent.width * root.share;
            height: parent.height;
            border-radius: 1.5px;
            background: root.share >= 0.5 ? Theme.mint : Theme.coral;
        }
    }
}

/// Body copy for panels: wraps, never shouts.
export component Caption inherits Text {
    text: "";
    font-family: Theme.font-body;
    font-size: TypeScale.caption;
    color: Theme.ink-faint;
    wrap: word-wrap;
}

/// Inert filter control. Shaped like the shipping app's selects (dark plate,
/// hairline, chevron) but never opens: the row it would filter has no data yet.
export component SelectBox inherits Rectangle {
    in property <string> value: "";
    in property <string> label: "Filter";
    in property <length> box-width: 168px;
    in property <bool> enabled: false;

    width: root.box-width;
    height: 30px;
    border-radius: Shape.sm;
    background: Theme.container;
    border-width: Shape.stroke;
    border-color: Theme.line;

    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.label;

    Text {
        x: 10px;
        y: (parent.height - self.height) / 2;
        text: root.value;
        font-family: Theme.font-body;
        font-size: TypeScale.caption;
        font-weight: 500;
        color: Theme.ink-dim;
    }

    Glyph {
        kind: "chevron-down";
        size: 13px;
        x: parent.width - self.width - 10px;
        y: (parent.height - self.height) / 2;
        stroke: Theme.ink-faint;
    }
}

/// Note band above a Tracker Network page: one sentence saying where the rows
/// came from, plus the state chip. `state` is the worker's ready|cached|
/// loading|empty|error — the chip's word and tone follow from it, never from a
/// guess here. `ready` shows `live-text`; every other state shows `note`, which
/// the worker has already phrased as a reason or an age.
export component SourceBand inherits Rectangle {
    in property <string> live-text: "";
    in property <string> note: "";
    in property <string> state: "empty";
    in property <string> glyph: "tracker";

    height: 34px;
    border-radius: Shape.sm;
    background: Theme.container-low;
    border-width: 1px;
    border-color: Theme.line-soft;

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.sm;

        VCenter {
            Glyph {
                kind: root.glyph;
                size: 14px;
                stroke: Theme.ink-faint;
            }
        }
        Text {
            text: root.state == "ready" ? root.live-text : root.note;
            font-family: Theme.font-body;
            font-size: TypeScale.micro;
            color: Theme.ink-dim;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        VCenter {
            Chip {
                text: root.state == "ready"
                    ? "LIVE"
                    : root.state == "cached"
                        ? "SAVED"
                        : root.state == "loading" ? "READING" : "NOT READ";
                tone: root.state == "ready"
                    ? "mint"
                    : root.state == "cached"
                        ? "neutral"
                        : root.state == "loading" ? "armed" : "off";
                pad-x: 7px;
                pad-y: 1px;
            }
        }
    }
}

/// Tab in the header band. Active gets the 2px violet underline; `soon` tabs
/// dim out and take no click. The optional dot is a fact, not decoration: the
/// caller binds it to a live match.
export component Tab inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> soon: false;
    in property <bool> dot: false;
    out property <bool> has-focus: scope.has-focus;
    callback clicked();

    height: 44px;
    background: transparent;
    accessible-role: button;
    accessible-enabled: !root.soon;
    accessible-label: root.label;
    accessible-action-default => { touch.clicked(); }

    touch := TouchArea {
        enabled: !root.soon;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // A tab is a button: Space/Return must work from the keyboard, and focus
    // has to be visible on a dark band.
    scope := FocusScope {
        x: 0;
        width: 0;
        enabled: !root.soon;

        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }

    if root.has-focus: Rectangle {
        x: 0;
        y: 4px;
        width: parent.width;
        height: parent.height - 8px;
        border-radius: 6px;
        border-width: 2px;
        border-color: Theme.primary;
        background: transparent;
    }

    HorizontalLayout {
        spacing: 6px;

        Text {
            text: root.label;
            font-family: Theme.font-body;
            font-size: TypeScale.body;
            font-weight: root.active ? 600 : 500;
            color: root.active
                ? Theme.primary
                : root.soon
                    ? Theme.ink-faint
                    : touch.has-hover
                        ? Theme.ink
                        : Theme.ink-dim;
            vertical-alignment: center;
            opacity: root.soon ? 0.8 : 1;
            animate color { duration: Motion.fast; easing: ease-out; }
        }
        if root.dot: VCenter {
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.coral;
            }
        }
    }

    if root.active: Rectangle {
        x: 0;
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        border-radius: 1px;
        background: Theme.primary;
    }
}

/// Opaque plate for the tracker grid: flat fill, hairline, 12px radius, and an
/// inner layout that owns the padding. Not the HUD's glass Plate — the shell
/// never floats over the game, so it never needs a gradient or a drop shadow.
export component Card inherits Rectangle {
    in property <length> pad: Space.lg;
    in property <length> gap: Space.md;

    border-radius: Shape.md;
    background: Theme.container;
    border-width: Shape.stroke;
    border-color: Theme.line-soft;

    VerticalLayout {
        padding: root.pad;
        spacing: root.gap;
        @children
    }
}

/// Settings band: no fill, a hairline on top, an eyebrow and an optional chip.
/// Bands replace the old stack of rounded cards so both views share one sheet.
export component Band inherits Rectangle {
    in property <bool> rule: true;
    in property <string> label: "";
    in property <string> note: "";
    in property <string> note-tone: "off";

    background: transparent;

    VerticalLayout {
        padding-bottom: Space.lg;
        spacing: Space.md;

        if root.rule: Rectangle {
            height: 1px;
            background: Theme.line-soft;
        }

        HorizontalLayout {
            height: 18px;
            spacing: Space.sm;
            PanelTitle { text: root.label; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if root.note != "": VCenter {
                Chip {
                    text: root.note;
                    tone: root.note-tone;
                    pad-y: 1px;
                }
            }
        }

        @children
    }
}
