// Page header: the one heading for the current view, with the tracker's tab row
// directly under it inside the same band (one rule closes the band, as in the
// shipping app). Settings has no tabs, so the band ends after the title row.
//
// Tabs are real buttons but only Overview has content in this build: the other
// four take no click, and the band says so on the right instead of pretending.

import { Theme, TypeScale, Space, Shape } from "tokens.slint";
import { Tracker } from "../state.slint";
import { Glyph, Tab, VCenter } from "widgets.slint";

export component Header inherits Rectangle {
    // Set by the shell so one header serves every view.
    in property <string> title: "Tracker";
    in property <string> subtitle: "";
    in property <string> icon: "tracker";
    in property <bool> show-tabs: true;
    // Tracker tab switching: the shell forwards this to Rust, which owns the
    // state (one writer), so the underline can never disagree with the page.
    callback select-tab(string);

    height: 54px + (root.show-tabs ? 44px : 0px);
    background: Theme.surface;

    VerticalLayout {
        spacing: 0;

        // Title row.
        HorizontalLayout {
            height: 54px;
            padding-left: Space.xl;
            padding-right: Space.xl;
            spacing: Space.md;

            VCenter {
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: Shape.sm;
                    background: Theme.container;
                    border-width: Shape.stroke;
                    border-color: Theme.line-soft;

                    Glyph {
                        kind: root.icon;
                        size: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        stroke: Theme.primary;
                    }
                }
            }

            Text {
                text: root.title;
                font-family: Theme.font-display;
                font-size: TypeScale.big;
                font-weight: 700;
                color: Theme.ink;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            // Right side is a fact when there is one: a live match beats the
            // static subtitle, and both come from state Rust already owns.
            if Tracker.live-state == "live": HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 8px;

                VCenter {
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.mint;
                    }
                }
                Text {
                    text: "LIVE · "
                        + (Tracker.map-name == "" ? "MATCH" : Tracker.map-name)
                        + " · " + Tracker.blue + "–" + Tracker.red;
                    font-family: Theme.font-mono;
                    font-size: TypeScale.micro;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                    color: Theme.mint;
                    vertical-alignment: center;
                }
            }
            if Tracker.live-state != "live": Text {
                text: root.subtitle;
                font-family: Theme.font-body;
                font-size: TypeScale.caption;
                color: Theme.ink-faint;
                vertical-alignment: center;
            }
        }

        // Tab row: same left edge as the title, underline on the active tab.
        if root.show-tabs: Rectangle {
            height: 44px;
            background: transparent;

            HorizontalLayout {
                padding-left: Space.xl;
                padding-right: Space.xl;
                spacing: 22px;

                Tab {
                    label: "Overview";
                    active: Tracker.tab == "overview";
                    clicked => { root.select-tab("overview"); }
                }
                Tab {
                    label: "Matches";
                    active: Tracker.tab == "matches";
                    clicked => { root.select-tab("matches"); }
                }
                Tab {
                    label: "Agents";
                    active: Tracker.tab == "agents";
                    clicked => { root.select-tab("agents"); }
                }
                Tab {
                    label: "Maps";
                    active: Tracker.tab == "maps";
                    clicked => { root.select-tab("maps"); }
                }
                Tab {
                    label: "Live Match";
                    soon: true;
                    dot: Tracker.live-state == "live";
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: "Overview, Matches, Agents and Maps are live; the rest are not ported.";
                    font-family: Theme.font-body;
                    font-size: TypeScale.micro;
                    color: Theme.ink-faint;
                    vertical-alignment: center;
                }
            }
        }
    }

    // One rule closes the header band.
    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.line-soft;
    }
}
