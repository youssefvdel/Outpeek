// Maps tab: Tracker Network's own table — one row per map in most-played
// order. The banner is the first column (art with a dark left-to-right scrim
// and the map name over it), then the map's two most-played agents (28px
// portraits with their win rates underneath), then the website's numeric
// columns: Win % | Wins | Losses | K/D | ADR | ACS | DDΔ. Values are
// pre-formatted by Rust at the Matches surface's 16px mono/700 step; an
// absent stat is an em dash. The portraits come from the payload's own
// `map-agent` segments, resolved against the agent rows.
//
// No kebab: the website's dots open a menu this app does not have, and a
// button that opens nothing is chrome that lies.

import { Theme, Space, Shape, TypeScale } from "tokens.slint";
import { Tracker, MapRowUi, MapAgentUi } from "../state.slint";
import { Cell, ColumnLabel, Glyph, VCenter } from "widgets.slint";

/// Single-sourced column widths shared by the header and every row.
/// Banner 180 + agents 100 + 74/52/56/52/62/62/58 = 696px fixed + gaps.
export global MapCols {
    in-out property <length> banner: 180px;
    in-out property <length> agents: 100px;
    in-out property <length> win: 74px;
    in-out property <length> wins: 52px;
    in-out property <length> losses: 56px;
    in-out property <length> kd: 52px;
    in-out property <length> adr: 62px;
    in-out property <length> acs: 62px;
    in-out property <length> dd: 58px;
}

/// One portrait plus the win rate this player has on the map with it.
component AgentPick inherits VerticalLayout {
    in property <MapAgentUi> item;
    width: 46px;
    spacing: 1px;

    Rectangle {
        width: 28px;
        height: 28px;
        x: (parent.width - self.width) / 2;
        border-radius: 6px;
        background: Theme.primary-deep;
        clip: true;

        if root.item.art.width > 0: Image {
            source: root.item.art;
            width: 28px;
            height: 28px;
            image-fit: cover;
        }
        if root.item.art.width == 0: Glyph {
            kind: "user";
            size: 13px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            stroke: Theme.primary;
            opacity: 0.7;
        }
    }
    Text {
        text: root.item.win == "" ? "—" : root.item.win;
        font-family: Theme.font-body;
        font-size: TypeScale.micro;
        color: Theme.ink-dim;
        horizontal-alignment: center;
    }
}

component MapTableRow inherits Rectangle {
    in property <MapRowUi> item;
    height: 56px;
    background: Theme.container;
    accessible-role: list-item;
    accessible-label: root.item.name + " " + root.item.win + " " + root.item.kd;

    // Row sum (fixed): 180 banner + 100 agents + 74/52/56/52/62/62/58
    // = 696px + 8 pad-r + 80 gaps = 784px.
    HorizontalLayout {
        padding-left: 0px;
        padding-right: Space.sm;
        spacing: 10px;

        // The map banner, full row height: the picture *is* the first column.
        Rectangle {
            min-width: MapCols.banner;
            horizontal-stretch: 1;
            clip: true;
            border-radius: Shape.sm;

            if root.item.art.width > 0: Image {
                width: parent.width;
                height: parent.height;
                source: root.item.art;
                image-fit: cover;
            }
            // Readable over any splash: a dark left-to-right scrim.
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: @linear-gradient(90deg, Theme.scrim-top 0%, Theme.scrim-mid 55%, Theme.scrim-clear 100%);
            }
            Text {
                x: 12px;
                text: root.item.name == "" ? "—" : root.item.name;
                font-family: Theme.font-display;
                font-size: TypeScale.title;
                font-weight: 700;
                color: Theme.ink;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // Top agents: the two picks, most played first. Empty when the payload
        // sent no `map-agent` segments for this map — an empty cell, never a
        // guessed portrait.
        VCenter {
            Rectangle {
                width: MapCols.agents;
                height: 44px;
                background: transparent;

                HorizontalLayout {
                    spacing: 4px;

                    for agent in root.item.agents: AgentPick { item: agent; }
                }
            }
        }

        // Every numeric cell is right-aligned 16px mono/700. An absent value
        // draws its em dash dim; Win % and DDΔ carry the result colours.
        VCenter {
            Cell {
                col-width: MapCols.win;
                value: root.item.win;
                mono: true;
                align-right: true;
                weight: 700;
                text-size: 16px;
                ink: root.item.win == ""
                    ? Theme.ink-dim
                    : root.item.win-share >= 0.5 ? Theme.mint : Theme.coral;
            }
        }
        VCenter {
            Cell {
                col-width: MapCols.wins;
                value: root.item.wins;
                mono: true;
                align-right: true;
                weight: 700;
                text-size: 16px;
                ink: root.item.wins == "" ? Theme.ink-dim : Theme.ink;
            }
        }
        VCenter {
            Cell {
                col-width: MapCols.losses;
                value: root.item.losses;
                mono: true;
                align-right: true;
                weight: 700;
                text-size: 16px;
                ink: root.item.losses == "" ? Theme.ink-dim : Theme.ink;
            }
        }
        VCenter {
            Cell {
                col-width: MapCols.kd;
                value: root.item.kd;
                mono: true;
                align-right: true;
                weight: 700;
                text-size: 16px;
                ink: root.item.kd == ""
                    ? Theme.ink-dim
                    : root.item.kd-low ? Theme.coral-dim : Theme.ink;
            }
        }
        VCenter {
            Cell {
                col-width: MapCols.adr;
                value: root.item.adr;
                mono: true;
                align-right: true;
                weight: 700;
                text-size: 16px;
                ink: root.item.adr == "" ? Theme.ink-dim : Theme.ink;
            }
        }
        VCenter {
            Cell {
                col-width: MapCols.acs;
                value: root.item.acs;
                mono: true;
                align-right: true;
                weight: 700;
                text-size: 16px;
                ink: root.item.acs == "" ? Theme.ink-dim : Theme.ink;
            }
        }
        VCenter {
            Cell {
                col-width: MapCols.dd;
                value: root.item.dd;
                mono: true;
                align-right: true;
                weight: 700;
                text-size: 16px;
                ink: root.item.dd == "" || root.item.dd == "0"
                    ? Theme.ink-dim
                    : root.item.dd-negative ? Theme.coral : Theme.mint;
            }
        }
    }
}

export component MapsPage inherits VerticalLayout {
    padding-left: Space.xl;
    padding-right: Space.xl;
    padding-top: 20px;
    padding-bottom: 20px;
    spacing: Space.md;

    // One table body card, the matches list's own: radius 16, a 1px border,
    // 14/16px padding. The 34px header and every 56px row live inside it with
    // no gaps, so an empty act reads as an inline note — never a strip above
    // the table.
    Rectangle {
        border-radius: 16px;
        background: Theme.container-low;
        border-width: 1px;
        border-color: Theme.container-high;

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 0px;

            // Header: one label per column, on the column's own edge. The Top
            // Agents column carries no label — the portraits need no
            // introduction, and the website names no state here either.
            // Header sum (fixed): 180 banner + 100 agents + 74/52/56/52/62/62/58
            // = 696px + 20 pads + 80 gaps = 796px.
            Rectangle {
                height: 34px;
                background: transparent;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: Space.sm;
                    spacing: 10px;

                    Text {
                        min-width: MapCols.banner;
                        horizontal-stretch: 1;
                        text: "Map Name";
                        font-family: Theme.font-body;
                        font-size: TypeScale.caption;
                        font-weight: 600;
                        color: Theme.ink-faint;
                        vertical-alignment: center;
                    }
                    Rectangle { width: MapCols.agents; }
                    ColumnLabel { col-width: MapCols.win; text: "Win %"; align-right: true; text-size: TypeScale.caption; }
                    ColumnLabel { col-width: MapCols.wins; text: "Wins"; align-right: true; text-size: TypeScale.caption; }
                    ColumnLabel { col-width: MapCols.losses; text: "Losses"; align-right: true; text-size: TypeScale.caption; }
                    ColumnLabel { col-width: MapCols.kd; text: "K/D"; align-right: true; text-size: TypeScale.caption; }
                    ColumnLabel { col-width: MapCols.adr; text: "ADR"; align-right: true; text-size: TypeScale.caption; }
                    ColumnLabel { col-width: MapCols.acs; text: "ACS"; align-right: true; text-size: TypeScale.caption; }
                    ColumnLabel { col-width: MapCols.dd; text: "DDΔ"; align-right: true; text-size: TypeScale.caption; }
                }
            }

            if Tracker.map-rows.length == 0: Rectangle {
                height: 120px;
                background: transparent;

                Text {
                    text: Tracker.breakdown-note == "" ? "No map rows for this act yet." : Tracker.breakdown-note;
                    font-family: Theme.font-body;
                    font-size: TypeScale.caption;
                    color: Theme.ink-faint;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            for row in Tracker.map-rows: MapTableRow { item: row; }
        }
    }
}
