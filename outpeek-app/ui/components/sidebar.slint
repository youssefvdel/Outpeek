// Left rail. Full window height, so its hairline runs from the top edge to the
// bottom like the shipping app's. The brand block is the rail's first row and
// is height-locked to the window chrome beside it; below it sit the player
// card, the eight nav rows and the active-display footer.
//
// Only the views that exist are in the rail. A row for an unported surface is a
// promise the UI cannot keep, so Store, Crosshair and the rest are added when
// they land, not greyed out before.

import { Theme, TypeScale, Space, Shape } from "tokens.slint";
import { Shell, Tracker } from "../state.slint";
import { Chip, Divider, Glyph, HCenter, NavItem, StateDot, VCenter } from "widgets.slint";
import { IconEye } from "icons.slint";

/// Brand mark: the real Lucide `eye` the React app uses for the tracker tab —
/// one stroked path, no second ink colour, no image file.
component BrandMark inherits Rectangle {
    width: 26px;
    height: 26px;

    IconEye {
        size: 26px;
        stroke: Theme.primary;
    }
}

/// Version badge. The string is Rust's crate version, pushed into `Tracker`;
/// if it is empty the badge is not drawn rather than showing a bare "v".
component VersionPill inherits Rectangle {
    in property <string> text: "";

    height: 20px;
    width: pill.width + 16px;
    border-radius: 10px;
    background: Theme.primary-deep;
    border-width: Shape.stroke;
    border-color: Theme.primary-dim;

    pill := Text {
        x: 8px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        font-family: Theme.font-mono;
        font-size: TypeScale.micro;
        font-weight: 700;
        color: Theme.primary;
    }
}

/// One rank cell of the player card. `sub` is RR for the current rank and a
/// literal PEAK for the peak cell; an empty rank prints an em dash.
///
/// The crest slot is a fixed 48x48 square with `image-fit: contain`: Riot's
/// tier art is a 256x256 PNG and must never be stretched. With no cached art
/// the drawn chevron fills the same slot, so a missing crest cannot move the
/// label or collapse the cell.
component RankCell inherits VerticalLayout {
    in property <image> crest;
    in property <string> label: "";
    in property <string> sub: "";
    in property <bool> known: false;

    spacing: 1px;

    HCenter {
        Rectangle {
            width: 48px;
            height: 48px;
            background: transparent;

            if root.crest.width > 0: Image {
                source: root.crest;
                width: 48px;
                height: 48px;
                image-fit: contain;
            }
            if root.crest.width == 0: Glyph {
                kind: "ranks";
                size: 20px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                stroke: root.known ? Theme.primary : Theme.ink-faint;
                opacity: root.known ? 1 : 0.5;
            }
        }
    }
    Text {
        text: root.label == "" ? "—" : root.label;
        font-family: Theme.font-display;
        font-size: TypeScale.caption;
        font-weight: 700;
        color: root.known ? Theme.ink : Theme.ink-faint;
        horizontal-alignment: center;
        overflow: elide;
    }
    Text {
        text: root.sub;
        font-family: Theme.font-mono;
        font-size: TypeScale.micro;
        color: root.known ? Theme.primary : Theme.ink-faint;
        horizontal-alignment: center;
    }
}

/// Player card: token-gradient banner (the shipping app puts the account's
/// background art there — this shell has no image pipeline, so the banner is
/// paint), avatar, name, and two rank cells split by a hairline.
component PlayerCard inherits Rectangle {
    height: 210px;
    border-radius: Shape.md;
    background: Theme.container;
    clip: true;

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: 62px;
        background: @linear-gradient(118deg, Theme.primary-dim 0%, Theme.primary-deep 58%, Theme.container 100%);
        clip: true;

        // The account's own playercard art, when the profile read carried one.
        // The gradient stays underneath as the fallback: a missing banner is a
        // colour, never a hole.
        if Tracker.player-banner.width > 0: Image {
            width: parent.width;
            height: parent.height;
            source: Tracker.player-banner;
            image-fit: cover;
        }
    }

    // Fade the banner into the card body; no hard seam, no extra colour.
    Rectangle {
        y: 0;
        width: root.width;
        height: 62px;
        background: @linear-gradient(180deg, transparent 55%, Theme.container 100%);
    }

    Rectangle {
        y: 61px;
        width: root.width;
        height: 1px;
        background: Theme.line-soft;
    }

    Rectangle {
        x: (root.width - 40px) / 2;
        y: 42px;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: Theme.container-highest;
        border-width: 3px;
        border-color: Theme.container;

        if Tracker.player-initial != "": Text {
            text: Tracker.player-initial;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            font-family: Theme.font-display;
            font-size: TypeScale.value;
            font-weight: 800;
            color: Theme.primary;
        }
        if Tracker.player-initial == "": Glyph {
            kind: "user";
            size: 18px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            stroke: Theme.ink-faint;
        }
    }

    Text {
        y: 88px;
        width: root.width;
        horizontal-alignment: center;
        text: Tracker.player-display == "" ? "Not signed in" : Tracker.player-display;
        font-family: Theme.font-body;
        font-size: TypeScale.caption;
        font-weight: 700;
        color: Tracker.player-display == "" ? Theme.ink-faint : Theme.ink;
        overflow: elide;
    }

    Rectangle {
        y: 110px;
        width: root.width;
        height: 1px;
        background: Theme.line-soft;
    }

    RankCell {
        x: 0;
        y: 116px;
        width: (root.width - 1px) / 2;
        height: 88px;
        crest: Tracker.rank-crest;
        label: Tracker.rank-label;
        // RR only exists on a local `/mmr` read. A Tracker Network rank is a
        // real Tier, but TRN publishes no RR, so the cell says so instead of
        // printing a 0 nobody measured.
        sub: Tracker.rank-state == "ok"
            ? (Tracker.rank-rr-known ? Tracker.rank-rr + " RR" : "NO RR")
            : Tracker.rank-state == "waiting" || Tracker.rank-state == "loading"
                ? "WAITING"
                : "—";
        known: Tracker.rank-state == "ok";
    }

    Rectangle {
        x: (root.width - 1px) / 2;
        y: 132px;
        width: 1px;
        height: 56px;
        background: Theme.line-soft;
    }

    RankCell {
        x: (root.width + 1px) / 2;
        y: 116px;
        width: (root.width - 1px) / 2;
        height: 88px;
        crest: Tracker.peak-crest;
        label: Tracker.peak-label;
        sub: "PEAK";
        known: Tracker.peak-label != "";
    }
}

/// Active display footer. Every field is bound to a `Tracker.display-*` string
/// that this shell does not fill yet; empty means UNAVAILABLE, never a guessed
/// 2560x1440.
component DisplayCard inherits Rectangle {
    border-radius: Shape.md;
    background: Theme.container;
    border-width: Shape.stroke;
    border-color: Theme.line-soft;

    // Fixed-height footer: rows hug at the top, one 6px gap between blocks.
    VerticalLayout {
        vertical-stretch: 0;
        padding: 13px;
        spacing: 7px;

        HorizontalLayout {
            height: 18px;
            spacing: 6px;

            VCenter {
                StateDot { tone: Tracker.display-resolution == "" ? "neutral" : "ok"; }
            }
            Text {
                text: "Active Display";
                font-family: Theme.font-body;
                font-size: TypeScale.caption;
                font-weight: 500;
                color: Theme.ink-dim;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if Tracker.display-mode != "": VCenter {
                Chip {
                    text: Tracker.display-mode;
                    tone: "neutral";
                    pad-x: 7px;
                    pad-y: 1px;
                }
            }
        }

        HorizontalLayout {
            height: 22px;
            spacing: 6px;

            Text {
                text: Tracker.display-resolution == "" ? "No display read-back" : Tracker.display-resolution;
                font-family: Theme.font-display;
                font-size: Tracker.display-resolution == "" ? TypeScale.caption : TypeScale.value;
                font-weight: 700;
                color: Tracker.display-resolution == "" ? Theme.ink-faint : Theme.ink;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if Tracker.display-refresh != "": VCenter {
                Rectangle {
                    height: 20px;
                    width: hz.width + 14px;
                    border-radius: 10px;
                    background: Theme.container-high;

                    hz := Text {
                        x: 7px;
                        y: (parent.height - self.height) / 2;
                        text: Tracker.display-refresh;
                        font-family: Theme.font-mono;
                        font-size: TypeScale.micro;
                        font-weight: 700;
                        color: Theme.ink-dim;
                    }
                }
            }
        }

        Divider {}

        HorizontalLayout {
            height: 16px;
            spacing: 6px;

            VCenter {
                Glyph {
                    kind: "cpu";
                    size: 12px;
                    stroke: Theme.ink-faint;
                }
            }
            Text {
                text: Tracker.display-gpu == "" ? "GPU not read" : Tracker.display-gpu;
                font-family: Theme.font-body;
                font-size: TypeScale.micro;
                color: Theme.ink-faint;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    callback toggle-hud();
    callback navigate(string);

    // The rail width the chrome row is locked to.
    width: Shell.rail-width;
    background: Theme.container-low;

    Rectangle {
        x: parent.width - 1px;
        y: 0;
        width: 1px;
        height: parent.height;
        background: Theme.line-soft;
    }

    // Brand row: same height as the titlebar next to it, and the whole row is
    // window-drag surface (no button lives here).
    Rectangle {
        y: 0;
        width: parent.width;
        height: Tracker.titlebar-height;
        background: transparent;

        WindowMoveArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
        }

        HorizontalLayout {
            padding-left: Space.lg;
            padding-right: Space.lg;
            spacing: Space.sm;

            VCenter { BrandMark {} }
            Text {
                text: "OUTPEEK";
                font-family: Theme.font-display;
                font-size: TypeScale.title;
                font-weight: 800;
                letter-spacing: 1.8px;
                color: Theme.ink;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if Tracker.version != "": VCenter {
                VersionPill { text: "v" + Tracker.version; }
            }
        }
    }

    // Footer is pinned to the bottom edge; the scrolling list gets the space
    // between the brand row and the footer. Explicit geometry, not nested
    // stretch: the card must never grow to fill the rail.
    DisplayCard {
        x: 14px;
        y: parent.height - 120px;
        width: parent.width - 28px;
        height: 106px;
    }

    // Player card + nav scroll together when the window is short.
    flick := Flickable {
        y: Tracker.titlebar-height;
        width: parent.width;
        height: parent.height - 166px;
        content-width: self.width;
        content-height: middle.preferred-height;

        middle := VerticalLayout {
            width: flick.content-width;
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 16px;
            padding-bottom: 8px;
            spacing: 0;

            PlayerCard {}

            Rectangle { height: 14px; }

            NavItem {
                label: "Tracker";
                glyph: "tracker";
                active: Tracker.view == "tracker";
                clicked => { root.navigate("tracker"); }
            }
            Rectangle { height: 2px; }
            NavItem {
                label: "Settings";
                glyph: "settings";
                active: Tracker.view == "settings";
                clicked => { root.navigate("settings"); }
            }
        }
    }
}
