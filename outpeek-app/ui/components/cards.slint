// Tracker view: the Overview page. Lifted from the shipping Recon shell —
// filter row, four headline numerals, one wide metrics strip, then the three
// analysis cards and the two history cards.
//
// The numbers are the remembered account's Tracker Network profile (direct,
// keyless transport; works with the Riot Client closed) merged with the local
// `/mmr` read when Riot answers. Every slot is a formatted string from Rust:
// empty means "not reported" and the cell draws an em dash — never a zero.
// A real zero (0 aces) arrives as "0" and is shown.

import { Theme, TypeScale, Space, Shape } from "tokens.slint";
import { Tracker } from "../state.slint";
import { Card, Chip, Glyph, HCenter, PanelTitle, VCenter } from "widgets.slint";

/// Honest "what this needs" note. One size below Caption so a missing value
/// reads as a footnote instead of a second headline.
component Need inherits Text {
    text: "";
    font-family: Theme.font-body;
    font-size: TypeScale.micro;
    color: Theme.ink-faint;
    wrap: word-wrap;
}

/// Em dash for an unknown value is always faint: a dash is the absence of data,
/// never a zero. (Plain Text at ink-faint, sized per call site.)

/// Card title (the one display-face line inside a card).
component CardTitle inherits Text {
    height: 18px;
    text: "";
    font-family: Theme.font-display;
    font-size: TypeScale.title;
    font-weight: 700;
    color: Theme.ink;
    vertical-alignment: center;
}

/// Act filter box: static display of the season the numbers belong to (TRN
/// desktop puts these above the headline numerals). Not a button: one act per
/// read, so there is nothing to pick. Binds to Tracker.profile-season and shows
/// an em dash until a read reports one — never a guessed season. Playlist has
/// its own dropdown component below: the payload carries four season queues.
component FilterBox inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <bool> known: false;

    height: 38px;
    border-radius: Shape.sm;
    background: Theme.container;
    border-width: Shape.stroke;
    border-color: Theme.line-soft;

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.sm;

        VCenter {
            PanelTitle { text: root.label; letter-spacing: 1px; }
        }
        VCenter {
            Text {
                text: root.value == "" ? "—" : root.value;
                font-family: Theme.font-body;
                font-size: TypeScale.caption;
                font-weight: 600;
                color: root.known ? Theme.ink : Theme.ink-faint;
                overflow: elide;
            }
        }
    }
}

/// PLAYLIST dropdown head: the same 38px box language as FilterBox, plus a
/// chevron because it opens. Built from Card/Chip/Glyph primitives on purpose:
/// no std-widgets ComboBox import, so the dark theme can never drift. Space /
/// Return toggle it; picking an option calls Tracker.select-playlist (Rust
/// owns the value, re-parses in memory, persists).
component PlaylistBox inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <bool> known: false;
    in property <bool> open: false;
    out property <bool> has-focus: scope.has-focus;
    callback toggled();

    height: 38px;
    border-radius: Shape.sm;
    background: root.open ? Theme.container-high : Theme.container;
    border-width: Shape.stroke;
    border-color: root.open ? Theme.primary-dim : Theme.line-soft;

    accessible-role: button;
    accessible-label: root.label + ": " + (root.value == "" ? "not read" : root.value);
    accessible-action-default => { touch.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }

    scope := FocusScope {
        x: 0;
        width: 0; // Tab-focusable, but clicks must not land here.

        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }

    if root.has-focus: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: Shape.sm - 1px;
        border-width: 2px;
        border-color: Theme.primary;
        background: transparent;
    }

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.sm;

        VCenter {
            PanelTitle { text: root.label; letter-spacing: 1px; }
        }
        VCenter {
            Text {
                text: root.value == "" ? "—" : root.value;
                font-family: Theme.font-body;
                font-size: TypeScale.caption;
                font-weight: 600;
                color: root.known ? Theme.ink : Theme.ink-faint;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        VCenter {
            Glyph {
                kind: "chevron-down";
                size: 14px;
                stroke: Theme.ink-dim;
            }
        }
    }
}

/// One PLAYLIST option row: a real button, flat at rest, wash when selected.
/// The caller binds `pid` to Tracker.playlists[idx] and the label to
/// Tracker.playlist-labels[idx] — ids and labels stay in one order.
component PlaylistOption inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    out property <bool> has-focus: scope.has-focus;
    callback picked();

    height: 30px;
    border-radius: Shape.sm;
    background: root.selected
        ? Theme.primary-wash
        : touch.has-hover ? Theme.container-high : transparent;

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { touch.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }

    scope := FocusScope {
        x: 0;
        width: 0;

        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;

        VCenter {
            Text {
                text: root.label;
                font-family: Theme.font-body;
                font-size: TypeScale.caption;
                font-weight: root.selected ? 700 : 500;
                color: root.selected ? Theme.primary : Theme.ink-dim;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Four headline numerals
// ---------------------------------------------------------------------------

component StatCard inherits Card {
    in property <string> label: "";
    in property <string> value: "—";
    in property <bool> known: false;
    in property <string> need: "";
    // Where this account sits among the players TRN tracks ("BOTTOM 10%").
    // Empty when the read carried no percentile: no label is drawn at all.
    in property <string> percentile: "";

    pad: 12px;
    gap: 2px;

    PanelTitle {
        text: root.label;
        letter-spacing: 1.2px;
    }
    Text {
        text: root.value;
        font-family: Theme.font-display;
        font-size: TypeScale.metric;
        font-weight: 800;
        color: root.known ? Theme.ink : Theme.ink-faint;
        letter-spacing: -0.5px;
    }
    if root.percentile != "": Text {
        text: root.percentile;
        font-family: Theme.font-mono;
        font-size: TypeScale.micro;
        color: Theme.ink-faint;
    }
    Need { text: root.need; }
}

// ---------------------------------------------------------------------------
// Eight-cell metrics strip
// ---------------------------------------------------------------------------

component MetricCell inherits VerticalLayout {
    in property <string> label: "";
    // Empty = not reported: the cell prints an em dash, not a zero.
    in property <string> value: "";
    in property <brush> tone: Theme.ink;

    spacing: 2px;

    PanelTitle {
        text: root.label;
        letter-spacing: 1px;
    }
    Text {
        text: root.value == "" ? "—" : root.value;
        font-family: Theme.font-display;
        font-size: TypeScale.value;
        font-weight: 700;
        color: root.value == "" ? Theme.ink-faint : root.tone;
    }
}

component MetricsStrip inherits Card {
    pad: 12px;
    gap: 0;

    HorizontalLayout {
        spacing: Space.sm;

        MetricCell { label: "WINS"; value: Tracker.metric-wins; horizontal-stretch: 1; tone: Theme.mint; }
        MetricCell { label: "LOSSES"; value: Tracker.metric-losses; horizontal-stretch: 1; tone: Theme.coral; }
        MetricCell { label: "KILLS"; value: Tracker.metric-kills; horizontal-stretch: 1; }
        MetricCell { label: "DEATHS"; value: Tracker.metric-deaths; horizontal-stretch: 1; }
        MetricCell { label: "ASSISTS"; value: Tracker.metric-assists; horizontal-stretch: 1; }
        MetricCell { label: "HEADSHOTS"; value: Tracker.metric-headshots; horizontal-stretch: 1; }
        MetricCell { label: "FLAWLESS"; value: Tracker.metric-flawless; horizontal-stretch: 1; }
        MetricCell { label: "CLUTCHES"; value: Tracker.metric-clutches; horizontal-stretch: 1; }
    }
}

// ---------------------------------------------------------------------------
// Combat highlights · top agent · accuracy
// ---------------------------------------------------------------------------

component HighlightRow inherits HorizontalLayout {
    // The shipping app's own round badge art (a 64x64 PNG whose circle IS the
    // chip surface). Passed in as an image so the row draws no invented glyph.
    in property <image> badge;
    in property <string> label: "";
    // Empty = not reported: an em dash, never a zero.
    in property <string> value: "";

    height: 36px;
    spacing: Space.md;

    VCenter {
        Rectangle {
            width: 30px;
            height: 30px;
            border-radius: 15px;
            background: Theme.container-high;

            // Chip geometry stays; the artwork is the content. `contain` with an
            // explicit square keeps the circular PNG circular at any scale.
            Image {
                width: 30px;
                height: 30px;
                source: root.badge;
                image-fit: contain;
            }
        }
    }

    VerticalLayout {
        spacing: 0px;
        horizontal-stretch: 1;

        Text {
            text: root.label;
            font-family: Theme.font-body;
            font-size: TypeScale.micro;
            color: Theme.ink-dim;
        }
        Text {
            text: root.value == "" ? "—" : root.value;
            font-family: Theme.font-display;
            font-size: TypeScale.value;
            font-weight: 700;
            color: root.value == "" ? Theme.ink-faint : Theme.ink;
        }
    }
}

component CombatHighlights inherits Card {
    pad: 12px;
    gap: 6px;

    HorizontalLayout {
        height: 18px;
        spacing: Space.sm;
        CardTitle { text: "Combat Highlights"; horizontal-stretch: 1; }
        if Tracker.profile-state != "ready" && Tracker.profile-state != "cached": Text {
            // State, not decoration: one quiet word instead of a pill on every
            // card. Nothing is shown when the read succeeded.
            text: Tracker.profile-state == "loading" ? "reading" : "not read";
            font-family: Theme.font-mono;
            font-size: TypeScale.micro;
            color: Theme.ink-faint;
            vertical-alignment: center;
        }
    }

    HighlightRow {
        badge: @image-url("../assets/badges/kills.png");
        label: "Match kills (best)";
        value: Tracker.best-kills;
    }
    HighlightRow {
        badge: @image-url("../assets/badges/firstbloods.png");
        label: "First kills / deaths";
        value: Tracker.first-blood-deaths;
    }
    HighlightRow {
        badge: @image-url("../assets/badges/aces.png");
        label: "Aces";
        value: Tracker.aces;
    }

    Rectangle { vertical-stretch: 1; }
}

component TopAgent inherits Card {
    pad: 14px;
    gap: 10px;

    HorizontalLayout {
        height: 18px;
        spacing: Space.sm;
        CardTitle { text: "Top Agent"; horizontal-stretch: 1; }
        VCenter {
            // The role is a fact from the agent catalogue, so it stays a chip.
            // No agent read is one quiet word, like the other cards: naming a
            // role nothing proved was the alternative.
            if Tracker.agent-role != "": Chip {
                text: Tracker.agent-role;
                tone: "neutral";
                pad-y: 1px;
            }
            if Tracker.agent-role == "": Text {
                text: "not read";
                font-family: Theme.font-mono;
                font-size: TypeScale.micro;
                color: Theme.ink-faint;
                vertical-alignment: center;
            }
        }
    }

    HorizontalLayout {
        height: 56px;
        spacing: Space.md;

        VCenter {
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 14px;
                background: Theme.primary-deep;

                // 56x56 portrait slot, `contain`: Riot's displayIcon is a
                // 1024x1024 cut-out and must keep its aspect inside the square.
                if Tracker.agent-icon.width > 0: Image {
                    source: Tracker.agent-icon;
                    width: 56px;
                    height: 56px;
                    image-fit: contain;
                }
                if Tracker.agent-icon.width == 0: Glyph {
                    kind: "user";
                    size: 22px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    stroke: Theme.primary;
                    opacity: 0.7;
                }
            }
        }

        VerticalLayout {
            spacing: 1px;
            horizontal-stretch: 1;

            Text {
                text: Tracker.agent-name == "" ? "No agent read" : Tracker.agent-name;
                font-family: Theme.font-display;
                font-size: TypeScale.title;
                font-weight: 700;
                color: Tracker.agent-name == "" ? Theme.ink-dim : Theme.ink;
                overflow: elide;
            }
            Text {
                text: Tracker.agent-line != ""
                    ? Tracker.agent-line
                    : (Tracker.agent-name == "" ? "Needs a Tracker Network profile." : "");
                font-family: Theme.font-body;
                font-size: TypeScale.micro;
                color: Theme.ink-faint;
                wrap: word-wrap;
            }
        }
    }

    Rectangle { vertical-stretch: 1; }

    // That agent's own numbers, not the season's: this card names one pick.
    HorizontalLayout {
        height: 34px;
        spacing: Space.md;

        VerticalLayout { horizontal-stretch: 1; spacing: 1px;
            PanelTitle { text: "WIN %"; letter-spacing: 0.8px; }
            Text { text: Tracker.agent-win-pct == "" ? "—" : Tracker.agent-win-pct; font-family: Theme.font-display; font-size: TypeScale.title; font-weight: 700; color: Tracker.agent-win-pct == "" ? Theme.ink-faint : Theme.ink; }
        }
        VerticalLayout { horizontal-stretch: 1; spacing: 1px;
            PanelTitle { text: "K/D"; letter-spacing: 0.8px; }
            Text { text: Tracker.agent-kd == "" ? "—" : Tracker.agent-kd; font-family: Theme.font-display; font-size: TypeScale.title; font-weight: 700; color: Tracker.agent-kd == "" ? Theme.ink-faint : Theme.ink; }
        }
        VerticalLayout { horizontal-stretch: 1; spacing: 1px;
            PanelTitle { text: "ADR"; letter-spacing: 0.8px; }
            Text { text: Tracker.agent-adr == "" ? "—" : Tracker.agent-adr; font-family: Theme.font-display; font-size: TypeScale.title; font-weight: 700; color: Tracker.agent-adr == "" ? Theme.ink-faint : Theme.ink; }
        }
        VerticalLayout { horizontal-stretch: 1; spacing: 1px;
            PanelTitle { text: "ACS"; letter-spacing: 0.8px; }
            Text { text: Tracker.agent-acs == "" ? "—" : Tracker.agent-acs; font-family: Theme.font-display; font-size: TypeScale.title; font-weight: 700; color: Tracker.agent-acs == "" ? Theme.ink-faint : Theme.ink; }
        }
    }
}

/// Abstract body chart: head, torso, legs as three opacity steps of one accent.
/// It carries no numbers, so it cannot imply a headshot split we do not have.
component BodyChart inherits Rectangle {
    in property <length> chart-width: 44px;
    in property <length> chart-height: 78px;

    width: root.chart-width;
    height: root.chart-height;

    Rectangle {
        x: (parent.width - 14px) / 2;
        y: 0;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.primary;
        opacity: 0.85;
    }
    Rectangle {
        x: (parent.width - 26px) / 2;
        y: 18px;
        width: 26px;
        height: 30px;
        border-radius: 8px;
        background: Theme.primary;
        opacity: 0.45;
    }
    Rectangle {
        x: (parent.width - 26px) / 2;
        y: 52px;
        width: 10px;
        height: 26px;
        border-radius: 5px;
        background: Theme.primary;
        opacity: 0.28;
    }
    Rectangle {
        x: (parent.width + 26px) / 2 - 10px;
        y: 52px;
        width: 10px;
        height: 26px;
        border-radius: 5px;
        background: Theme.primary;
        opacity: 0.28;
    }
}

component AccuracyRow inherits HorizontalLayout {
    height: 23px;
    in property <string> label: "";
    in property <string> value: "";
    in property <string> hits-label: "";

    spacing: Space.sm;

    Text {
        text: root.label;
        font-family: Theme.font-body;
        font-size: TypeScale.caption;
        color: Theme.ink-dim;
        width: 46px;
        vertical-alignment: center;
    }
    Text {
        text: root.value == "" ? "—" : root.value;
        font-family: Theme.font-display;
        font-size: TypeScale.value;
        font-weight: 700;
        color: root.value == "" ? Theme.ink-faint : Theme.ink;
        horizontal-alignment: right;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }
    Text {
        text: root.hits-label == "" ? "— hits" : root.hits-label;
        font-family: Theme.font-mono;
        font-size: TypeScale.micro;
        color: Theme.ink-faint;
        horizontal-alignment: right;
        // Wide enough for "1,962 hits" — the old 54px clipped the count at the
        // card edge, which read as a broken number.
        width: 76px;
        vertical-alignment: center;
    }
}

component Accuracy inherits Card {
    pad: 14px;
    gap: 10px;

    HorizontalLayout {
        height: 18px;
        spacing: Space.sm;
        CardTitle { text: "Accuracy"; horizontal-stretch: 1; }
        if Tracker.profile-state != "ready" && Tracker.profile-state != "cached": Text {
            // State, not decoration: one quiet word instead of a pill on every
            // card. Nothing is shown when the read succeeded.
            text: Tracker.profile-state == "loading" ? "reading" : "not read";
            font-family: Theme.font-mono;
            font-size: TypeScale.micro;
            color: Theme.ink-faint;
            vertical-alignment: center;
        }
    }

    HorizontalLayout {
        height: 85px;
        spacing: Space.lg;

        VCenter { BodyChart {} }
        VerticalLayout {
            spacing: Space.sm;
            horizontal-stretch: 1;
            AccuracyRow {
                label: "Head";
                value: Tracker.acc-head;
                hits-label: Tracker.acc-head-hits-label;
            }
            AccuracyRow {
                label: "Body";
                value: Tracker.acc-body;
                hits-label: Tracker.acc-body-hits-label;
            }
            AccuracyRow {
                label: "Legs";
                value: Tracker.acc-legs;
                hits-label: Tracker.acc-legs-hits-label;
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}

// ---------------------------------------------------------------------------
// Previous acts · tracker score
// ---------------------------------------------------------------------------

component ActColumn inherits VerticalLayout {
    height: 76px;
    // The act TRN named (e.g. "V26: ACT V"); empty prints an em dash.
    in property <string> when: "";
    // The rank that act's peak reached; empty prints an em dash.
    in property <string> value: "";
    // The act's crest, when art for that tier is cached. Empty keeps the drawn
    // ranks glyph: a missing emblem must not collapse the column.
    in property <image> crest;
    spacing: 2px;
    // The act's own label, crest and value are one group: centre them in the
    // card instead of leaving the slack under the last line.
    alignment: center;

    PanelTitle {
        text: root.when == "" ? "—" : root.when;
        letter-spacing: 0.8px;
        horizontal-alignment: center;
    }

    HCenter {
        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 17px;
            background: Theme.container-high;

            if root.crest.width > 0: Image {
                source: root.crest;
                width: 34px;
                height: 34px;
                image-fit: contain;
            }
            if root.crest.width == 0: Glyph {
                kind: "ranks";
                size: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                stroke: root.value == "" ? Theme.ink-faint : Theme.primary;
                opacity: root.value == "" ? 0.45 : 1;
            }
        }
    }

    Text {
        text: root.value == "" ? "—" : root.value;
        font-family: Theme.font-display;
        font-size: TypeScale.title;
        font-weight: 700;
        color: root.value == "" ? Theme.ink-faint : Theme.ink;
        horizontal-alignment: center;
        overflow: elide;
    }
}

component PreviousActs inherits Card {
    pad: 14px;
    gap: 8px;

    HorizontalLayout {
        height: 18px;
        spacing: Space.sm;
        CardTitle { text: "Peak Acts on Record"; horizontal-stretch: 1; }
    }

    // Three fixed slots, never invented: TRN sends one `peak-rating` segment
    // (fixture: 1 row, Season 26 Act 6 only). The `metadata.seasons` list
    // names Season 26 Acts 6/5/4 but carries IDs, not ranks, and all 20
    // trn_matches rows are the current act — so there is nothing honest to
    // wire into slots 2/3. Empty slots keep em dashes; no `if` branches, no
    // guessed ranks. Only slot 1 gets the peak crest; the others keep the
    // faint ranks glyph so no emblem is implied.
    HorizontalLayout {
        height: 78px;
        spacing: Space.md;

        ActColumn {
            when: Tracker.act1-label;
            value: Tracker.act1-value;
            crest: Tracker.peak-crest;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 1px;
            background: Theme.line-soft;
        }
        ActColumn {
            when: Tracker.act2-label;
            value: Tracker.act2-value;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 1px;
            background: Theme.line-soft;
        }
        ActColumn {
            when: Tracker.act3-label;
            value: Tracker.act3-value;
            horizontal-stretch: 1;
        }
    }

    Need {
        text: Tracker.act1-label == ""
            ? "No peak acts reported yet."
            : "Tracker Network reports one peak act.";
    }

    Rectangle { vertical-stretch: 1; }
}

component ScoreMetric inherits VerticalLayout {
    in property <string> label: "";
    in property <string> value: "";
    in property <string> percentile: "";
    spacing: 1px;

    PanelTitle { text: root.label; letter-spacing: 0.8px; }
    Text {
        text: root.value == "" ? "—" : root.value;
        font-family: Theme.font-display;
        font-size: TypeScale.title;
        font-weight: 700;
        color: root.value == "" ? Theme.ink-faint : Theme.ink;
    }
    if root.percentile != "": Text {
        text: root.percentile;
        font-family: Theme.font-mono;
        font-size: TypeScale.micro;
        color: Theme.ink-faint;
    }
}

/// One embedded Tracker Score medallion. Six square files, one per tier key;
/// explicit 38px square + `contain` so the 24x24 viewBox is never stretched.
component GradeImage inherits Image {
    width: 38px;
    height: 38px;
    image-fit: contain;
}

/// Tracker Score medallion slot. `grade` is the tier key from
/// `badges::score_badge` ("1K" | "S" | "A" | "B" | "C" | "D"); an empty key is
/// unrated and keeps the drawn shield, because no art exists for "no grade".
component ScoreMedallion inherits Rectangle {
    in property <string> grade: "";

    width: 38px;
    height: 38px;
    background: transparent;

    if root.grade == "": Rectangle {
        width: 38px;
        height: 38px;
        border-radius: 19px;
        background: Theme.container-high;

        Glyph {
            kind: "shield";
            size: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            stroke: Theme.primary;
            opacity: 0.45;
        }
    }

    // The shipping app's own hex emblems, copied from `src/assets/badges/`.
    // The UI never chooses a grade; it only picks the file for the key Rust
    // hands it. An unknown key draws nothing rather than a wrong medal.
    if root.grade == "1K": GradeImage { source: @image-url("../assets/badges/score-1k.svg"); }
    if root.grade == "S": GradeImage { source: @image-url("../assets/badges/score-s.svg"); }
    if root.grade == "A": GradeImage { source: @image-url("../assets/badges/score-a.svg"); }
    if root.grade == "B": GradeImage { source: @image-url("../assets/badges/score-b.svg"); }
    if root.grade == "C": GradeImage { source: @image-url("../assets/badges/score-c.svg"); }
    if root.grade == "D": GradeImage { source: @image-url("../assets/badges/score-d.svg"); }
}

component TrackerScore inherits Card {
    pad: 14px;
    gap: 10px;

    HorizontalLayout {
        height: 18px;
        spacing: Space.sm;
        CardTitle { text: "Tracker Score"; horizontal-stretch: 1; }
        VCenter {
            // UNRATED is the absence of a score; once a number exists the chip
            // names its band, so the badge and the chip can never disagree.
            Chip {
                text: Tracker.score-badge == ""
                    ? (Tracker.score-value == "" ? "UNRATED" : "PER ACT")
                    : "TIER " + Tracker.score-badge;
                tone: Tracker.score-badge == "" && Tracker.score-value == "" ? "off" : "neutral";
                pad-y: 1px;
            }
        }
    }

    HorizontalLayout {
        height: 38px;
        spacing: Space.md;

        VCenter {
            ScoreMedallion { grade: Tracker.score-badge; }
        }

        Text {
            text: Tracker.score-value == "" ? "—" : Tracker.score-value;
            font-family: Theme.font-display;
            font-size: TypeScale.metric;
            font-weight: 800;
            color: Tracker.score-value == "" ? Theme.ink-faint : Theme.ink;
        }

        Need {
            text: Tracker.score-value == "" ? "A score needs the four metrics below." : "";
            horizontal-stretch: 1;
        }
    }

    Rectangle { vertical-stretch: 1; }

    HorizontalLayout {
        height: 34px;
        spacing: Space.md;
        ScoreMetric { label: "ROUND WIN %"; value: Tracker.score-round-win-pct; percentile: Tracker.round-win-pctile; horizontal-stretch: 1; }
        ScoreMetric { label: "KAST"; value: Tracker.score-kast; percentile: Tracker.kast-pctile; horizontal-stretch: 1; }
        ScoreMetric { label: "ACS"; value: Tracker.score-acs; percentile: Tracker.acs-pctile; horizontal-stretch: 1; }
        ScoreMetric { label: "DDA/ROUND"; value: Tracker.score-dda; percentile: Tracker.dda-pctile; horizontal-stretch: 1; }
    }
}

// ---------------------------------------------------------------------------
// Page
// ---------------------------------------------------------------------------

export component TrackerPage inherits VerticalLayout {
    padding-left: Space.xl;
    padding-right: Space.xl;
    padding-top: 20px;
    padding-bottom: 20px;
    spacing: Space.md;

    // Transient UI state only: whether the PLAYLIST options list is open.
    // The selected value itself is Rust-owned (Tracker.playlist, like `tab`).
    property <bool> playlist-open: false;

    // A status line that only exists when something is not ready. The account
    // read is normally invisible; when it is cached or failed, one chip and the
    // reason say so without a permanent caption on the page.
    if Tracker.profile-state != "ready": HorizontalLayout {
        height: 22px;
        spacing: Space.sm;

        Rectangle { horizontal-stretch: 1; }
        VCenter {
            Chip {
                text: Tracker.profile-state == "cached"
                    ? "SAVED"
                    : Tracker.profile-state == "error"
                        ? "OFFLINE"
                        : Tracker.profile-state == "loading" ? "READING" : "NOT READ";
                tone: Tracker.profile-state == "cached"
                    ? "neutral"
                    : Tracker.profile-state == "error" ? "error" : "off";
                pad-x: 7px;
                pad-y: 1px;
            }
        }
        Text {
            text: Tracker.profile-message;
            font-family: Theme.font-body;
            font-size: TypeScale.micro;
            color: Theme.ink-faint;
            vertical-alignment: center;
            overflow: elide;
            max-width: 620px;
        }
    }

    // Playlist / Act selectors, TRN-desktop shaped: two boxes side by side
    // above the headline numerals, left-aligned. PLAYLIST is a real dropdown
    // over exactly the four season playlists the payload carries; a pick
    // re-parses the last body in memory (no refetch) and persists.
    HorizontalLayout {
        height: 38px;
        spacing: Space.md;

        PlaylistBox {
            label: "PLAYLIST";
            value: Tracker.playlist-label;
            known: Tracker.playlist-label != "";
            open: playlist-open;
            toggled => { playlist-open = !playlist-open; }
            width: 210px;
        }
        // ACT stays a label: TRN sends a single act per profile read, so there
        // is nothing to pick.
        FilterBox {
            label: "ACT";
            value: Tracker.profile-season;
            known: Tracker.profile-season != "";
            width: 270px;
        }

        Rectangle { horizontal-stretch: 1; }
    }

    // PLAYLIST options: the four payload playlists, theme-matched list from
    // Card primitives (no std-widgets ComboBox). Pushes content down while open
    // rather than floating over the headline cards — no guessed overlay math.
    if playlist-open: Card {
        pad: 6px;
        gap: 2px;
        width: 210px;

        for pid[idx] in Tracker.playlists: PlaylistOption {
            label: Tracker.playlist-labels[idx];
            selected: Tracker.playlist == pid;
            picked => {
                Tracker.select-playlist(pid);
                playlist-open = false;
            }
        }
    }

    HorizontalLayout {
        height: 96px;
        spacing: Space.md;
        StatCard {
            label: "WIN %";
            value: Tracker.win-pct == "" ? "—" : Tracker.win-pct;
            known: Tracker.win-pct != "";
            percentile: Tracker.win-pctile;
            need: Tracker.win-pct == "" ? (Tracker.profile-state == "loading" ? "Reading Tracker Network…" : "Not reported for this act.") : "";
            horizontal-stretch: 1;
        }
        StatCard {
            label: "K/D";
            value: Tracker.kd == "" ? "—" : Tracker.kd;
            known: Tracker.kd != "";
            percentile: Tracker.kd-pctile;
            need: Tracker.kd == "" ? (Tracker.profile-state == "loading" ? "Reading Tracker Network…" : "Not reported for this act.") : "";
            horizontal-stretch: 1;
        }
        StatCard {
            label: "HEADSHOT %";
            value: Tracker.hs-pct == "" ? "—" : Tracker.hs-pct;
            known: Tracker.hs-pct != "";
            percentile: Tracker.hs-pctile;
            need: Tracker.hs-pct == "" ? (Tracker.profile-state == "loading" ? "Reading Tracker Network…" : "Not reported for this act.") : "";
            horizontal-stretch: 1;
        }
        StatCard {
            label: "DAMAGE/ROUND";
            value: Tracker.dmg-round == "" ? "—" : Tracker.dmg-round;
            known: Tracker.dmg-round != "";
            percentile: Tracker.dpr-pctile;
            need: Tracker.dmg-round == "" ? (Tracker.profile-state == "loading" ? "Reading Tracker Network…" : "Not reported for this act.") : "";
            horizontal-stretch: 1;
        }
    }

    MetricsStrip { height: 64px; }

    HorizontalLayout {
        height: 176px;
        spacing: Space.md;
        CombatHighlights { horizontal-stretch: 1; }
        TopAgent { horizontal-stretch: 1; }
        Accuracy { horizontal-stretch: 1; }
    }

    HorizontalLayout {
        height: 165px;
        spacing: Space.md;
        PreviousActs { horizontal-stretch: 1; }
        TrackerScore { horizontal-stretch: 1; }
    }
}
