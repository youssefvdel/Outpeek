// Tracker view: the Overview page. Lifted from the shipping Recon shell —
// filter row, four headline numerals, one wide metrics strip, then the three
// analysis cards and the two history cards.
//
// Every numeral here is a slot, not a number. This build has no match history
// (see ROADMAP.md), so each card prints an em dash and one line saying what it
// would need; nothing is estimated and no row is faked.

import { Theme, TypeScale, Space } from "tokens.slint";
import { Tracker } from "../state.slint";
import { Card, Chip, Glyph, HCenter, PanelTitle, SelectBox, VCenter } from "widgets.slint";

/// Honest "what this needs" note. One size below Caption so a missing value
/// reads as a footnote instead of a second headline.
component Need inherits Text {
    text: "";
    font-family: Theme.font-body;
    font-size: TypeScale.micro;
    color: Theme.ink-faint;
    wrap: word-wrap;
}

/// Em dash for an unknown value is always faint: a dash is the absence of data,
/// never a zero. (Plain Text at ink-faint, sized per call site.)

/// Card title (the one display-face line inside a card).
component CardTitle inherits Text {
    height: 18px;
    text: "";
    font-family: Theme.font-display;
    font-size: TypeScale.title;
    font-weight: 700;
    color: Theme.ink;
    vertical-alignment: center;
}

// ---------------------------------------------------------------------------
// Filter row
// ---------------------------------------------------------------------------

component FilterRow inherits Rectangle {
    height: 49px;
    background: transparent;

    HorizontalLayout {
        spacing: Space.lg;

        VerticalLayout {
            spacing: 4px;
            PanelTitle { text: "PLAYLIST"; }
            SelectBox { value: "Any"; label: "Playlist filter — not ported"; }
        }

        VerticalLayout {
            spacing: 4px;
            PanelTitle { text: "ACT"; }
            SelectBox { value: "All acts"; box-width: 152px; label: "Act filter — not ported"; }
        }

        Rectangle { horizontal-stretch: 1; }

        HorizontalLayout {
            spacing: Space.sm;

            VCenter {
                Chip { text: "SOON"; tone: "off"; pad-x: 7px; pad-y: 1px; }
            }
            Text {
                text: "Filters open once match history is read.";
                font-family: Theme.font-body;
                font-size: TypeScale.micro;
                color: Theme.ink-faint;
                vertical-alignment: center;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Four headline numerals
// ---------------------------------------------------------------------------

component StatCard inherits Card {
    in property <string> label: "";
    in property <string> value: "—";
    in property <bool> known: false;
    in property <string> need: "";

    pad: 12px;
    gap: 2px;

    PanelTitle {
        text: root.label;
        letter-spacing: 1.2px;
    }
    Text {
        text: root.value;
        font-family: Theme.font-display;
        font-size: TypeScale.metric;
        font-weight: 800;
        color: root.known ? Theme.ink : Theme.ink-faint;
        letter-spacing: -0.5px;
    }
    Need { text: root.need; }
}

// ---------------------------------------------------------------------------
// Eight-cell metrics strip
// ---------------------------------------------------------------------------

component MetricCell inherits VerticalLayout {
    in property <string> label: "";
    in property <string> value: "—";
    in property <bool> known: false;
    in property <brush> tone: Theme.ink;

    spacing: 2px;

    PanelTitle {
        text: root.label;
        letter-spacing: 1px;
    }
    Text {
        text: root.value;
        font-family: Theme.font-display;
        font-size: TypeScale.value;
        font-weight: 700;
        color: root.known ? root.tone : Theme.ink-faint;
    }
}

component MetricsStrip inherits Card {
    pad: 12px;
    gap: 0;

    HorizontalLayout {
        spacing: Space.sm;

        MetricCell { label: "WINS"; horizontal-stretch: 1; tone: Theme.mint; }
        MetricCell { label: "LOSSES"; horizontal-stretch: 1; tone: Theme.coral; }
        MetricCell { label: "KILLS"; horizontal-stretch: 1; }
        MetricCell { label: "DEATHS"; horizontal-stretch: 1; }
        MetricCell { label: "ASSISTS"; horizontal-stretch: 1; }
        MetricCell { label: "HEADSHOTS"; horizontal-stretch: 1; }
        MetricCell { label: "FLAWLESS"; horizontal-stretch: 1; }
        MetricCell { label: "CLUTCHES"; horizontal-stretch: 1; }
    }
}

// ---------------------------------------------------------------------------
// Combat highlights · top agent · accuracy
// ---------------------------------------------------------------------------

component HighlightRow inherits HorizontalLayout {
    // The shipping app's own round badge art (a 64x64 PNG whose circle IS the
    // chip surface). Passed in as an image so the row draws no invented glyph.
    in property <image> badge;
    in property <string> label: "";
    in property <string> value: "—";

    height: 36px;
    spacing: Space.md;

    VCenter {
        Rectangle {
            width: 30px;
            height: 30px;
            border-radius: 15px;
            background: Theme.container-high;

            // Chip geometry stays; the artwork is the content. `contain` with an
            // explicit square keeps the circular PNG circular at any scale.
            Image {
                width: 30px;
                height: 30px;
                source: root.badge;
                image-fit: contain;
            }
        }
    }

    VerticalLayout {
        spacing: 0px;
        horizontal-stretch: 1;

        Text {
            text: root.label;
            font-family: Theme.font-body;
            font-size: TypeScale.micro;
            color: Theme.ink-dim;
        }
        Text {
            text: root.value;
            font-family: Theme.font-display;
            font-size: TypeScale.value;
            font-weight: 700;
            color: root.value == "—" ? Theme.ink-faint : Theme.ink;
        }
    }
}

component CombatHighlights inherits Card {
    pad: 12px;
    gap: 6px;

    HorizontalLayout {
        height: 18px;
        spacing: Space.sm;
        CardTitle { text: "Combat Highlights"; horizontal-stretch: 1; }
        VCenter {
            Chip { text: "NOT READ"; tone: "off"; pad-y: 1px; }
        }
    }

    HighlightRow {
        badge: @image-url("../assets/badges/kills.png");
        label: "Match kills (best)";
    }
    HighlightRow {
        badge: @image-url("../assets/badges/firstbloods.png");
        label: "First kills / deaths";
    }
    HighlightRow {
        badge: @image-url("../assets/badges/aces.png");
        label: "Aces";
    }

    Rectangle { vertical-stretch: 1; }
}

component TopAgent inherits Card {
    in property <string> role: "";

    pad: 14px;
    gap: 10px;

    HorizontalLayout {
        height: 18px;
        spacing: Space.sm;
        CardTitle { text: "Top Agent"; horizontal-stretch: 1; }
        VCenter {
            Chip { text: root.role == "" ? "NOT READ" : root.role; tone: "off"; pad-y: 1px; }
        }
    }

    HorizontalLayout {
        height: 44px;
        spacing: Space.md;

        VCenter {
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: Theme.primary-deep;

                Glyph {
                    kind: "user";
                    size: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    stroke: Theme.primary;
                    opacity: 0.7;
                }
            }
        }

        VerticalLayout {
            spacing: 1px;
            horizontal-stretch: 1;

            Text {
                text: "No agent read";
                font-family: Theme.font-display;
                font-size: TypeScale.title;
                font-weight: 700;
                color: Theme.ink-dim;
            }
            Text {
                text: "Needs this act's match details.";
                font-family: Theme.font-body;
                font-size: TypeScale.micro;
                color: Theme.ink-faint;
                wrap: word-wrap;
            }
        }
    }

    Rectangle { vertical-stretch: 1; }

    HorizontalLayout {
        height: 34px;
        spacing: Space.md;

        VerticalLayout { horizontal-stretch: 1; spacing: 1px;
            PanelTitle { text: "WIN %"; letter-spacing: 0.8px; }
            Text { text: "—"; font-family: Theme.font-display; font-size: TypeScale.title; font-weight: 700; color: Theme.ink-faint; }
        }
        VerticalLayout { horizontal-stretch: 1; spacing: 1px;
            PanelTitle { text: "K/D"; letter-spacing: 0.8px; }
            Text { text: "—"; font-family: Theme.font-display; font-size: TypeScale.title; font-weight: 700; color: Theme.ink-faint; }
        }
        VerticalLayout { horizontal-stretch: 1; spacing: 1px;
            PanelTitle { text: "ADR"; letter-spacing: 0.8px; }
            Text { text: "—"; font-family: Theme.font-display; font-size: TypeScale.title; font-weight: 700; color: Theme.ink-faint; }
        }
        VerticalLayout { horizontal-stretch: 1; spacing: 1px;
            PanelTitle { text: "ACS"; letter-spacing: 0.8px; }
            Text { text: "—"; font-family: Theme.font-display; font-size: TypeScale.title; font-weight: 700; color: Theme.ink-faint; }
        }
    }
}

/// Abstract body chart: head, torso, legs as three opacity steps of one accent.
/// It carries no numbers, so it cannot imply a headshot split we do not have.
component BodyChart inherits Rectangle {
    in property <length> chart-width: 44px;
    in property <length> chart-height: 78px;

    width: root.chart-width;
    height: root.chart-height;

    Rectangle {
        x: (parent.width - 14px) / 2;
        y: 0;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.primary;
        opacity: 0.85;
    }
    Rectangle {
        x: (parent.width - 26px) / 2;
        y: 18px;
        width: 26px;
        height: 30px;
        border-radius: 8px;
        background: Theme.primary;
        opacity: 0.45;
    }
    Rectangle {
        x: (parent.width - 26px) / 2;
        y: 52px;
        width: 10px;
        height: 26px;
        border-radius: 5px;
        background: Theme.primary;
        opacity: 0.28;
    }
    Rectangle {
        x: (parent.width + 26px) / 2 - 10px;
        y: 52px;
        width: 10px;
        height: 26px;
        border-radius: 5px;
        background: Theme.primary;
        opacity: 0.28;
    }
}

component AccuracyRow inherits HorizontalLayout {
    height: 23px;
    in property <string> label: "";
    in property <string> value: "—";
    in property <string> hits: "— hits";

    spacing: Space.sm;

    Text {
        text: root.label;
        font-family: Theme.font-body;
        font-size: TypeScale.caption;
        color: Theme.ink-dim;
        width: 46px;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        font-family: Theme.font-display;
        font-size: TypeScale.value;
        font-weight: 700;
        color: Theme.ink-faint;
        horizontal-alignment: right;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }
    Text {
        text: root.hits;
        font-family: Theme.font-mono;
        font-size: TypeScale.micro;
        color: Theme.ink-faint;
        horizontal-alignment: right;
        width: 54px;
        vertical-alignment: center;
    }
}

component Accuracy inherits Card {
    pad: 14px;
    gap: 10px;

    HorizontalLayout {
        height: 18px;
        spacing: Space.sm;
        CardTitle { text: "Accuracy"; horizontal-stretch: 1; }
        VCenter {
            Chip { text: "NOT READ"; tone: "off"; pad-y: 1px; }
        }
    }

    HorizontalLayout {
        height: 85px;
        spacing: Space.lg;

        VCenter { BodyChart {} }
        VerticalLayout {
            spacing: Space.sm;
            horizontal-stretch: 1;
            AccuracyRow { label: "Head"; }
            AccuracyRow { label: "Body"; }
            AccuracyRow { label: "Legs"; }
        }
    }

    Rectangle { vertical-stretch: 1; }
}

// ---------------------------------------------------------------------------
// Previous acts · tracker score
// ---------------------------------------------------------------------------

component ActColumn inherits VerticalLayout {
    height: 105px;
    in property <string> when: "";
    spacing: 2px;

    PanelTitle {
        text: root.when;
        letter-spacing: 0.8px;
        horizontal-alignment: center;
    }

    HCenter {
        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 17px;
            background: Theme.container-high;

            Glyph {
                kind: "ranks";
                size: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                stroke: Theme.primary;
                opacity: 0.45;
            }
        }
    }

    PanelTitle {
        text: "PEAK RATING";
        letter-spacing: 0.8px;
        horizontal-alignment: center;
    }
    Text {
        text: "—";
        font-family: Theme.font-display;
        font-size: TypeScale.title;
        font-weight: 700;
        color: Theme.ink-faint;
        horizontal-alignment: center;
    }
    Text {
        text: "not read";
        font-family: Theme.font-body;
        font-size: TypeScale.micro;
        color: Theme.ink-faint;
        horizontal-alignment: center;
    }
}

component PreviousActs inherits Card {
    pad: 14px;
    gap: 10px;

    HorizontalLayout {
        height: 18px;
        spacing: Space.sm;
        CardTitle { text: "Previous Acts"; horizontal-stretch: 1; }
        VCenter {
            Chip { text: "COMPETITIVE HISTORY"; tone: "off"; pad-y: 1px; }
        }
    }

    HorizontalLayout {
        height: 105px;
        spacing: Space.md;

        ActColumn { when: "LAST ACT"; horizontal-stretch: 1; }
        Rectangle { width: 1px; background: Theme.line-soft; }
        ActColumn { when: "2 ACTS AGO"; horizontal-stretch: 1; }
        Rectangle { width: 1px; background: Theme.line-soft; }
        ActColumn { when: "3 ACTS AGO"; horizontal-stretch: 1; }
    }

    Rectangle { vertical-stretch: 1; }
}

component ScoreMetric inherits VerticalLayout {
    in property <string> label: "";
    spacing: 1px;

    PanelTitle { text: root.label; letter-spacing: 0.8px; }
    Text {
        text: "—";
        font-family: Theme.font-display;
        font-size: TypeScale.title;
        font-weight: 700;
        color: Theme.ink-faint;
    }
}

/// One embedded Tracker Score medallion. Six square files, one per tier key;
/// explicit 38px square + `contain` so the 24x24 viewBox is never stretched.
component GradeImage inherits Image {
    width: 38px;
    height: 38px;
    image-fit: contain;
}

/// Tracker Score medallion slot. `grade` is the tier key from
/// `badges::score_badge` ("1K" | "S" | "A" | "B" | "C" | "D"); an empty key is
/// unrated and keeps the drawn shield, because no art exists for "no grade".
component ScoreMedallion inherits Rectangle {
    in property <string> grade: "";

    width: 38px;
    height: 38px;
    background: transparent;

    if root.grade == "": Rectangle {
        width: 38px;
        height: 38px;
        border-radius: 19px;
        background: Theme.container-high;

        Glyph {
            kind: "shield";
            size: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            stroke: Theme.primary;
            opacity: 0.45;
        }
    }

    // The shipping app's own hex emblems, copied from `src/assets/badges/`.
    // The UI never chooses a grade; it only picks the file for the key Rust
    // hands it. An unknown key draws nothing rather than a wrong medal.
    if root.grade == "1K": GradeImage { source: @image-url("../assets/badges/score-1k.svg"); }
    if root.grade == "S": GradeImage { source: @image-url("../assets/badges/score-s.svg"); }
    if root.grade == "A": GradeImage { source: @image-url("../assets/badges/score-a.svg"); }
    if root.grade == "B": GradeImage { source: @image-url("../assets/badges/score-b.svg"); }
    if root.grade == "C": GradeImage { source: @image-url("../assets/badges/score-c.svg"); }
    if root.grade == "D": GradeImage { source: @image-url("../assets/badges/score-d.svg"); }
}

component TrackerScore inherits Card {
    pad: 14px;
    gap: 10px;

    HorizontalLayout {
        height: 18px;
        spacing: Space.sm;
        CardTitle { text: "Tracker Score"; horizontal-stretch: 1; }
        VCenter {
            // UNRATED is the absence of a tier; once a tier exists the chip
            // names it, so the badge and the chip can never disagree.
            Chip {
                text: Tracker.score-badge == "" ? "UNRATED" : "TIER " + Tracker.score-badge;
                tone: Tracker.score-badge == "" ? "off" : "neutral";
                pad-y: 1px;
            }
        }
    }

    HorizontalLayout {
        height: 38px;
        spacing: Space.md;

        VCenter {
            ScoreMedallion { grade: Tracker.score-badge; }
        }

        Text {
            text: "—";
            font-family: Theme.font-display;
            font-size: TypeScale.metric;
            font-weight: 800;
            color: Theme.ink-faint;
        }

        Need {
            text: Tracker.score-badge == "" ? "A tier needs the four metrics below." : "";
            horizontal-stretch: 1;
        }
    }

    Rectangle { vertical-stretch: 1; }

    HorizontalLayout {
        height: 34px;
        spacing: Space.md;
        ScoreMetric { label: "ROUND WIN %"; horizontal-stretch: 1; }
        ScoreMetric { label: "KAST"; horizontal-stretch: 1; }
        ScoreMetric { label: "ACS"; horizontal-stretch: 1; }
        ScoreMetric { label: "DDA/ROUND"; horizontal-stretch: 1; }
    }
}

// ---------------------------------------------------------------------------
// Page
// ---------------------------------------------------------------------------

export component TrackerPage inherits VerticalLayout {
    padding-left: Space.xl;
    padding-right: Space.xl;
    padding-top: 20px;
    padding-bottom: 20px;
    spacing: Space.md;

    FilterRow {}

    HorizontalLayout {
        height: 96px;
        spacing: Space.md;
        StatCard { label: "WIN %"; horizontal-stretch: 1; need: "needs match outcomes"; }
        StatCard { label: "K/D"; horizontal-stretch: 1; need: "needs kills and deaths"; }
        StatCard { label: "HEADSHOT %"; horizontal-stretch: 1; need: "needs per-match hit data"; }
        StatCard { label: "DAMAGE/ROUND"; horizontal-stretch: 1; need: "needs round damage"; }
    }

    MetricsStrip { height: 64px; }

    HorizontalLayout {
        height: 176px;
        spacing: Space.md;
        CombatHighlights { horizontal-stretch: 1; }
        TopAgent { horizontal-stretch: 1; }
        Accuracy { horizontal-stretch: 1; }
    }

    HorizontalLayout {
        height: 165px;
        spacing: Space.md;
        PreviousActs { horizontal-stretch: 1; }
        TrackerScore { horizontal-stretch: 1; }
    }
}
