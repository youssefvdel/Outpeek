// Outpeek app shell. One window; the HUD is a second Window from the
// `outpeek-overlay` crate at runtime. Tokens and shared widgets come from that
// crate's UI through build.rs include paths — no copies.
//
// Structure is the shipping Recon shell: a full-height rail on the left, and on
// the right the window chrome row, the page header with the tracker's tabs, then
// the content sheet. Tracker and Settings are real and switch in place (the
// sidebar writes `Tracker.view`); the other rows and tabs stay marked SOON
// because they are not ported — a dead screen would be a lie.
//
// Frameless by construction: DWM paints a system title bar's surface above the
// client area, and no frame attribute removes it (the caption colour only
// repaints it). So the window has no system title bar at all; TitleBar draws
// our own chrome and Rust owns the window commands.

import { Theme } from "tokens.slint";
import { Tracker } from "state.slint";
import { Sidebar } from "components/sidebar.slint";
import { Header } from "components/header.slint";
import { TitleBar } from "components/titlebar.slint";
import { TrackerPage } from "components/cards.slint";
import { SettingsPage } from "components/settings.slint";
import { MatchesPage } from "components/matches.slint";
import { AgentsPage } from "components/agents.slint";
import { MapsPage } from "components/maps.slint";
import { LivePage } from "components/live.slint";

// Re-exported so the Rust side can address the same globals, push the titlebar
// geometry, and use the row struct without the deprecated generated alias.
export { Tracker, Settings, SettingsItem } from "state.slint";
export { Theme } from "tokens.slint";

export component AppWindow inherits Window {
    title: "Outpeek — " + (Tracker.view == "settings" ? "Settings" : "Tracker");
    // No system frame: no caption, no DWM title-bar surface, no pale band.
    no-frame: true;
    // A frameless window has no system resize border. Slint's winit backend
    // starts a resize drag only when the pointer is within this many logical
    // pixels of an edge, so without it the window cannot be resized at all.
    resize-border-width: 6px;
    // The shipping app opens at 1216x804; the shell's grid is tuned to that.
    preferred-width: Tracker.window-width;
    preferred-height: Tracker.window-height;
    // 1120 keeps the three-card row (title + state chip) on one line; below it
    // the dashboard would start eliding its own labels.
    min-width: 1120px;
    min-height: 680px;
    // The resize ceiling, declared because Slint derives the window's min AND
    // max from this layout: a finite maximum computed from the content (~984 px
    // on Windows) wins over `preferred-width`, so the shell opened at min width
    // (996x819 outer measured live). 4K is the clamp, not a launch size; the
    // window system still caps to the work area.
    max-width: 3840px;
    max-height: 2160px;
    background: Theme.surface;

    callback toggle-hud();
    callback refresh-rank();
    // Navigation goes through Rust so the view state has one owner (and one
    // debug log line per click).
    callback navigate(string);
    // Tracker tab (Overview | Matches). Rust owns it, like the sidebar view.
    callback select-tab(string);
    // Window commands. Rust calls Win32 and reads the state back; the UI never
    // pretends a window was minimised because a button was pressed.
    callback minimize-window();
    callback toggle-maximize();
    callback close-window();

    // The rail spans the full height (its hairline reaches the top edge, as in
    // the shipping app), so the chrome row sits only over the content column.
    HorizontalLayout {
        Sidebar {
            toggle-hud => { root.toggle-hud(); }
            navigate(view) => { root.navigate(view); }
        }

        VerticalLayout {
            TitleBar {
                bar-height: Tracker.titlebar-height;
                control-width: Tracker.control-width;
                max-glyph: Tracker.max-glyph;
                max-label: Tracker.max-label;
                minimize-window => { root.minimize-window(); }
                toggle-maximize => { root.toggle-maximize(); }
                close-window => { root.close-window(); }
                refresh-rank => { root.refresh-rank(); }
                toggle-hud => { root.toggle-hud(); }
            }

            Header {
                title: Tracker.view == "settings" ? "Settings" : "Tracker";
                icon: Tracker.view == "settings" ? "settings" : "tracker";
                show-tabs: Tracker.view == "tracker";
                select-tab(tab) => { root.select-tab(tab); }
                subtitle: Tracker.view == "settings"
                    ? "What this build really does — and what it does not"
                    : (Tracker.profile-subtitle != ""
                        ? Tracker.profile-subtitle
                        : "Live from the Riot Client loopback — read-only");
            }

            // One scroll surface for both views: the tracker grid and the
            // settings bands both exceed a short window, and neither view
            // should clip its last row instead of scrolling to it.
            // The wrapper exists for the scroll affordance: Slint draws no
            // scrollbar, and at the 680 px minimum the page is taller than the
            // viewport. The bar is a fact about the content, so it appears only
            // when there is more to scroll to.
            Rectangle {
                vertical-stretch: 1;
                background: transparent;

            flick := Flickable {
                // Both percentages are load-bearing: a Flickable's preferred
                // size is its content's, so without them the column shrank to
                // the widest row (Matches/Agents/Maps stopped ~156 px short of
                // the window edge) and the viewport grew to the page's height
                // instead of scrolling it.
                width: 100%;
                height: 100%;
                content-width: self.width;
                content-height: page.preferred-height;

                page := VerticalLayout {
                    width: flick.content-width;

                    if Tracker.view == "tracker" && Tracker.tab == "overview": TrackerPage {}
                    if Tracker.view == "tracker" && Tracker.tab == "matches": MatchesPage {}
                    if Tracker.view == "tracker" && Tracker.tab == "agents": AgentsPage {}
                    if Tracker.view == "tracker" && Tracker.tab == "maps": MapsPage {}
                    if Tracker.view == "tracker" && Tracker.tab == "live": LivePage {}
                    if Tracker.view == "settings": SettingsPage {
                        toggle-hud => { root.toggle-hud(); }
                    }
                }
            }

            if flick.content-height > flick.height: Rectangle {
                width: 3px;
                height: Math.max(
                    (flick.height * flick.height) / Math.max(flick.content-height, 1px),
                    24px
                );
                x: parent.width - 5px;
                y: (flick.height - self.height)
                    * (flick.content-y / Math.max(flick.content-height - flick.height, 1px));
                border-radius: 1.5px;
                background: Theme.line;
            }
            }
        }
    }
}
