// Outpeek app — the one data contract between Rust and the tracker window.
// Rust owns every value; `.slint` renders and never formats a fact.
// Unknown values are empty strings, never placeholders-as-data.

// One row of the Settings page's "not ported yet" list.
export struct SettingsItem {
    title: string,
    detail: string,
}

// App-shell geometry the titlebar shares with the rail, so the two columns can
// never disagree about where the content starts.
export global Shell {
    in-out property <length> rail-width: 272px;
}

/// One played match, pre-formatted by Rust. Every field is a string so the
/// view cannot re-derive or invent a number; `won` only picks the colour.
/// One match row, TRN-website shaped: portrait, age + mode over map (+ ordinal
/// placement when reported), the rounds score in the result colour, the TRS
/// and clutch badge chips, then the per-match numbers. Every field is
/// pre-formatted; `won` only picks the score colour and `clutch-bad` the chip
/// ink. Weapon stats have no payload source, so none appear here either.
export struct MatchRowUi {
    id: string,
    // "Bind 9th" when a placement was reported, else the bare map.
    map: string,
    // "2d ago // Competitive" — the row's first line, owned by Rust.
    age: string,
    score: string,
    won: bool,
    agent: string,
    // "TRS 279" — hidden when empty.
    trs: string,
    // First tags[] name ("1v1 Lost") — hidden when empty.
    clutch: string,
    // The clutch tone was Negative: coral ink, else mint.
    clutch-bad: bool,
    art: image,
    kda: string,
    kd: string,
    hs: string,
    dd: string,
    acs: string,
}

/// One card of the top-3 agent strip: portrait, name, `7W - 9L (44%)`, K/D.
/// All pre-formatted; an empty `art` draws the fallback glyph.
export struct MatchAgentUi {
    name: string,
    record: string,
    kd: string,
    art: image,
}

/// One cell of the recent-form strip: age, rounds score, K/D. `won` picks the
/// score colour with the row's existing result rule.
export struct MatchFormUi {
    age: string,
    score: string,
    won: bool,
    kd: string,
}

/// One day-group header: `Nov 14 [1]` plus the day's W/L, K/D, summed K/D/A,
/// signed damage, mean HS% and ACS. All pre-formatted by Rust.
export struct MatchDayUi {
    title: string,
    wl: string,
    kd: string,
    kda: string,
    dda: string,
    hs: string,
    acs: string,
}

/// One scoreboard row on the match detail view, pre-formatted by Rust.
/// Empty strings draw as em dashes (`Cell` owns that rule).
export struct MatchPlayerUi {
    name: string,
    agent: string,
    art: image,
    rank: string,
    acs: string,
    kda: string,
    kd: string,
    hs: string,
    kast: string,
    dd: string,
}

/// One round cell on the match detail strip. `blue` picks the colour;
/// `tip` ("Round 3 — Blue, Elimination") is the accessible name and the
/// tapped/hovered result line, so the colour is never the only signal.
export struct MatchRoundUi {
    label: string,
    blue: bool,
    result: string,
    tip: string,
}

/// One agent row on the Agents tab, pre-formatted by Rust from the same
/// Tracker Network payload as the Overview. `win-share` (0–1) only widths the
/// bar; the percentage beside it is the reported number. `art` is the cached
/// portrait — an empty image draws the fallback glyph.
export struct AgentRowUi {
    name: string,
    role: string,
    matches: string,
    win: string,
    kd: string,
    acs: string,
    adr: string,
    hs: string,
    pick: string,
    win-share: float,
    art: image,
}

/// One player of the live lobby, pre-formatted by Rust. `rank` is a fact or an
/// honest state (RANK HIDDEN / UNRATED / NOT READ) — the view never derives one.
export struct LivePlayerUi {
    name: string,
    agent: string,
    agent-art: image,
    level: string,
    rank: string,
    rr: string,
    crest: image,
    party: string,
    me: bool,
    incognito: bool,
}

/// One map card on the Maps tab. Art is valorant-api's `listViewIcon`, cached
/// locally; the numbers come from the same profile payload as the agents.
export struct MapRowUi {
    name: string,
    matches: string,
    win: string,
    kd: string,
    acs: string,
    adr: string,
    hs: string,
    win-share: float,
    art: image,
}

export global Tracker {
    // Shell navigation. UI state, not a fact: Rust sets it from the sidebar's
    // `navigate` callback. "tracker" | "settings".
    in-out property <string> view: "tracker";
    // Active tracker tab: "overview" | "matches" | "agents" | "maps". Rust owns
    // it, so the underline and the page can never disagree.
    in-out property <string> tab: "overview";

    // Recent matches (Tracker Network). `matches-state` is ready|cached|
    // loading|empty|error and `matches-note` carries the reason/age line.
    in-out property <[MatchRowUi]> matches: [];
    // TRN-website strips, derived from the same rows/payload as `matches`.
    in-out property <[MatchAgentUi]> match-agents: [];
    in-out property <[MatchFormUi]> match-form: [];
    // Day groups: `match-days[i]` heads `match-day-rows[i]`. The two models
    // are built together, so the indices always agree.
    in-out property <[MatchDayUi]> match-days: [];
    in-out property <[[MatchRowUi]]> match-day-rows: [];
    in-out property <string> matches-state: "empty";
    in-out property <string> matches-note: "No matches read yet.";

    // Match detail (one scoreboard, opened from a Matches row — NO separate
    // tab). `match-id` is the open selection: empty = the table shows.
    // `match-state` is empty|loading|ready|error, `match-note` the reason.
    // Row click -> `select-match(id)` (Rust fetches on demand, memory-only);
    // Back -> `close-match-detail()` clears the selection, table returns.
    callback select-match(string);
    callback close-match-detail();
    in-out property <string> match-id: "";
    in-out property <string> match-state: "empty";
    in-out property <string> match-note: "";
    // "Bind · Competitive · Nov 14 · 48m 27s" and "Blue 14 – 16 Red".
    in-out property <string> match-title: "";
    in-out property <string> match-score: "";
    in-out property <bool> match-blue-won: false;
    in-out property <bool> match-red-won: false;
    in-out property <[MatchPlayerUi]> match-blue: [];
    in-out property <[MatchPlayerUi]> match-red: [];
    in-out property <[MatchRoundUi]> match-rounds: [];

    // Agent and map breakdowns (same Tracker Network payload as the profile,
    // never a second request). Maps arrive pre-chunked three per row: Slint's
    // GridLayout ignores runtime `col:` inside a `for`, so the row grouping is
    // data, not layout arithmetic. `breakdown-state` shares the five states;
    // `breakdown-note` carries the reason/age line when the rows are not live.
    in-out property <[AgentRowUi]> agents: [];
    in-out property <[[MapRowUi]]> map-grid: [];
    in-out property <string> breakdown-state: "empty";
    in-out property <string> breakdown-note: "No profile read yet.";

    // Riot Client / poll state.
    in-out property <string> client-line: "Starting…";
    in-out property <string> client-tone: "warn"; // "ok" | "warn" | "error"

    // Local account.
    in-out property <string> player-display: "";
    in-out property <string> player-initial: "";

    // Rank panel. state: waiting | loading | ok | unranked | unknown | error.
    in-out property <string> rank-state: "waiting";
    in-out property <string> rank-label: "";
    in-out property <int> rank-rr: 0;
    // False when the rank cell is filled from Tracker Network, which publishes
    // no RR. The card then prints NO RR instead of a zero nobody measured.
    in-out property <bool> rank-rr-known: false;
    in-out property <string> rank-message: "Waiting for the Riot Client.";
    // Peak rank from Riot's own act history (the best tier across the acts the
    // `/mmr` payload reports). Empty = no act reported one: the cell keeps its
    // em dash rather than printing "Unrated".
    in-out property <string> peak-label: "";

    // ---------------------------------------------------------------------
    // Tracker Network profile (keyless direct transport; works with Riot off).
    // Every string is a formatted value or empty. Empty is drawn as an em
    // dash; it never means zero.
    // ---------------------------------------------------------------------
    // state: loading | ready | cached | empty | error.
    in-out property <string> profile-state: "empty";
    // One honest line: the cache age, the failure reason, or nothing.
    in-out property <string> profile-message: "";
    in-out property <string> profile-handle: "";
    // Season the numbers belong to ("Season 26 Act 6").
    in-out property <string> profile-season: "";
    in-out property <string> profile-matches: "";
    // Page-header subtitle while a profile is loaded (Rust owns the wording).
    in-out property <string> profile-subtitle: "";
    // Playlist the Overview season frame shows ("competitive" | "deathmatch" |
    // "swiftplay" | "skirmish2v2"). Rust owns it like `tab`: the dropdown
    // offers exactly the four season playlists the payload carries, and the
    // worker re-parses the last body in memory when it changes.
    in-out property <string> playlist: "competitive";
    // Display label for `playlist` ("Competitive" … "2v2"), resolved by Rust
    // so the view never maps an id to the wrong words.
    in-out property <string> playlist-label: "Competitive";
    // The dropdown's options, ids and labels in the same order. Fixed at four:
    // no unrated segment exists in the payload, so none is offered.
    in-out property <[string]> playlists: ["competitive", "deathmatch", "swiftplay", "skirmish2v2"];
    in-out property <[string]> playlist-labels: ["Competitive", "Deathmatch", "Swiftplay", "2v2"];
    // Overview → Rust: the playlist picked in the PLAYLIST dropdown. Rust
    // validates (unknown → competitive), re-parses in memory and persists.
    callback select-playlist(string);

    // Four headline numerals.
    in-out property <string> win-pct: "";
    in-out property <string> kd: "";
    in-out property <string> hs-pct: "";
    in-out property <string> dmg-round: "";

    // Eight-cell strip.
    in-out property <string> metric-wins: "";
    in-out property <string> metric-losses: "";
    in-out property <string> metric-kills: "";
    in-out property <string> metric-deaths: "";
    in-out property <string> metric-assists: "";
    in-out property <string> metric-headshots: "";
    in-out property <string> metric-flawless: "";
    in-out property <string> metric-clutches: "";

    // Combat highlights.
    in-out property <string> best-kills: "";
    // "first bloods / first deaths" as one ratio line.
    in-out property <string> first-blood-deaths: "";
    in-out property <string> aces: "";

    // Accuracy: share of dealt shots and the raw hit count.
    in-out property <string> acc-head: "";
    in-out property <string> acc-head-hits: "";
    in-out property <string> acc-body: "";
    in-out property <string> acc-body-hits: "";
    in-out property <string> acc-legs: "";
    in-out property <string> acc-legs-hits: "";

    // Top agent: the card's four metrics are that agent's, not the season's.
    in-out property <string> agent-line: "";
    in-out property <string> agent-win-pct: "";
    in-out property <string> agent-kd: "";
    in-out property <string> agent-adr: "";
    in-out property <string> agent-acs: "";

    // Previous acts: label = the act TRN named, value = the rank it reported.
    // Empty slots keep em dashes; no act is ever guessed.
    in-out property <string> act1-label: "";
    in-out property <string> act1-value: "";
    in-out property <string> act2-label: "";
    in-out property <string> act2-value: "";
    in-out property <string> act3-label: "";
    in-out property <string> act3-value: "";

    // Tracker Score (0–1000 band; the badge key comes from `badges.rs`).
    in-out property <string> score-value: "";
    in-out property <string> score-round-win-pct: "";
    in-out property <string> score-kast: "";
    in-out property <string> score-acs: "";
    in-out property <string> score-dda: "";
    in-out property <string> win-pctile: "";
    in-out property <string> kd-pctile: "";
    in-out property <string> hs-pctile: "";
    in-out property <string> dpr-pctile: "";
    in-out property <string> round-win-pctile: "";
    in-out property <string> kast-pctile: "";
    in-out property <string> acs-pctile: "";
    in-out property <string> dda-pctile: "";

    // Game art, fetched and cached at runtime (never bundled: see assets.rs).
    // An empty image means "no art cached", and the UI draws its own fallback
    // glyph — a missing crest must not collapse the cell.
    in-out property <image> rank-crest;
    in-out property <image> peak-crest;
    in-out property <image> agent-icon;
    // The account's playercard art for the rail banner (TRN `avatarUrl`),
    // cached like every other piece of art. Empty = the painted gradient.
    in-out property <image> player-banner;
    // Top Agent fact. Empty until a read reports one (match details own it), and
    // the card then shows its honest empty state.
    in-out property <string> agent-name: "";
    in-out property <string> agent-role: "";

    // Tracker Score medallion key, from `badges::score_badge`: "1K" | "S" | "A"
    // | "B" | "C" | "D", or empty for unrated. Rust owns the grade rule; the
    // UI only picks the asset, so no letter is ever guessed here.
    in-out property <string> score-badge: "";

    // Live lobby board (the Live Match tab). `live-roster-state` is
    // idle|pregame|coregame|error; `live-note` carries the reason when there is
    // no board. Team rows are pre-formatted, like every other row in this file.
    in-out property <[LivePlayerUi]> live-blue-team: [];
    in-out property <[LivePlayerUi]> live-red-team: [];
    in-out property <string> live-roster-state: "idle";
    in-out property <string> live-note: "No live match read yet.";
    // The board's own strip values: the live read is newer than the presence
    // facts, so this tab reads these instead of the snapshot's copies (which an
    // idle tick would otherwise clear under it).
    in-out property <string> live-map: "";
    in-out property <string> live-mode: "";
    in-out property <int> live-blue-score: 0;
    in-out property <int> live-red-score: 0;

    // Live panel. state: loading | empty | live | error.
    in-out property <string> live-state: "loading";
    in-out property <string> live-message: "Reading the Riot Client…";
    in-out property <string> phase-title: "Waiting";
    in-out property <string> phase-chip: "…";
    in-out property <string> map-name: "";
    in-out property <string> mode: "";
    in-out property <int> blue: 0;
    in-out property <int> red: 0;

    // HUD kill switch + status. tone: off | armed | live | unsupported.
    in-out property <bool> hud-enabled: true;
    in-out property <string> hud-status: "Armed — waiting for VALORANT";
    in-out property <string> hud-tone: "armed";

    // Honest platform note (e.g. "Windows only" on a Linux dev host).
    in-out property <string> platform-note: "";

    // Active display, for the sidebar footer card. Empty means "this shell has
    // not read the display": the card prints UNAVAILABLE rather than a guessed
    // mode. No Rust pass fills these yet — adding it is a display read-back,
    // not a data shape change, so the card is already bound correctly.
    in-out property <string> display-mode: "";
    in-out property <string> display-resolution: "";
    in-out property <string> display-refresh: "";
    in-out property <string> display-gpu: "";

    // The window's preferred size. Rust sets these from the remembered size at
    // boot: a page switch re-derives the window size from the layout, so a
    // restore that only called `set_size` was discarded the moment a tab with
    // different content opened.
    in-out property <length> window-width: 1216px;
    in-out property <length> window-height: 804px;

    // Titlebar geometry. Rust pushes `app_window::TITLEBAR_HEIGHT` and
    // `CONTROL_WIDTH` here so the drawn bar and the Win32 hit/region maths are
    // the same numbers, not two copies.
    in-out property <length> titlebar-height: 38px;
    in-out property <length> control-width: 46px;

    // Window state, read back from the native window (IsZoomed) rather than
    // remembered from the last click: a snap drag changes it with no callback.
    // The glyph is a fact Rust derives from that state; the UI only draws it.
    in-out property <string> max-glyph: "maximize"; // "maximize" | "restore"
    in-out property <string> max-label: "Maximize";

    in-out property <string> version: "";
}

// Settings page values. Every string is resolved by `settings_model` at boot;
// empty means "nothing honest to show", and the page never invents a value.
export global Settings {
    // HUD overlay.
    in-out property <string> hud-rule: "";
    in-out property <string> hud-file: "";
    // Appearance.
    in-out property <string> theme-line: "";
    // Data & logs. `*-resolved` = false means the row carries a reason instead
    // of a path (missing APPDATA, no log identifier).
    in-out property <string> data-path: "";
    in-out property <bool> data-resolved: false;
    in-out property <string> log-path: "";
    in-out property <bool> log-resolved: false;
    // Slint MCP.
    in-out property <string> mcp-line: "";
    in-out property <string> mcp-tone: "off"; // ok | off | warn
    // Version.
    in-out property <string> version-line: "";
    in-out property <string> build-line: "";
    // Not ported yet.
    in-out property <[SettingsItem]> not-ported: [];
}
